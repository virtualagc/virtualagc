  TST_PART: COMPOOL RIGID;
C  Probe 2: PARTIAL initializers, to see how far a clause reaches.
  DECLARE TSPB_GUARD1 BIT(16) INITIAL(HEX'7771');
C  full list, 4 of 4
  DECLARE TSPB_FULL ARRAY(4) BIT(16) INITIAL(
     HEX'C101',HEX'C102',HEX'C103',HEX'C104');
  DECLARE TSPB_GUARD2 BIT(16) INITIAL(HEX'7772');
C  single value, replicated across 4
  DECLARE TSPB_REPL ARRAY(4) BIT(16) INITIAL(HEX'C201');
  DECLARE TSPB_GUARD3 BIT(16) INITIAL(HEX'7773');
C  partial list, 2 of 4
  DECLARE TSPB_PART ARRAY(4) BIT(16) INITIAL(
     HEX'C301',HEX'C302');
  DECLARE TSPB_GUARD4 BIT(16) INITIAL(HEX'7774');
C  structure array, partial
 STRUCTURE TSPK_REC RIGID:
  1 SFLD1 BIT(16),
  1 SFLD2 BIT(16);
  DECLARE TSPK_PART TSPK_REC-STRUCTURE(3) INITIAL(
     HEX'D101',HEX'D102',HEX'D201');
  DECLARE TSPB_GUARD5 BIT(16) INITIAL(HEX'7775');
  CLOSE_TSP: CLOSE;
