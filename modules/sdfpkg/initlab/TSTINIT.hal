  TST_INIT: COMPOOL RIGID;
C  Probe compool for what HALSFC emits under each initialization state.
C  Guards carry HEX'666n' so probes can be located despite reordering.
C  ---- scalars ----
  DECLARE TSTB_GUARD1 BIT(16) INITIAL(HEX'6661');
  DECLARE TSTB_ZERO BIT(16) INITIAL(HEX'0000');
  DECLARE TSTB_GUARD2 BIT(16) INITIAL(HEX'6662');
  DECLARE TSTB_UNINIT BIT(16);
  DECLARE TSTB_GUARD3 BIT(16) INITIAL(HEX'6663');
  DECLARE TSTB_NONZERO BIT(16) INITIAL(HEX'A001');
  DECLARE TSTB_GUARD4 BIT(16) INITIAL(HEX'6664');
C  ---- integers, for alignment effects ----
  DECLARE TSTI_ZERO INTEGER INITIAL(0);
  DECLARE TSTB_GUARD5 BIT(16) INITIAL(HEX'6665');
  DECLARE TSTI_UNINIT INTEGER;
  DECLARE TSTB_GUARD6 BIT(16) INITIAL(HEX'6666');
  DECLARE TSTI_NONZERO INTEGER INITIAL(4097);
  DECLARE TSTB_GUARD7 BIT(16) INITIAL(HEX'6667');
C  ---- arrays ----
  DECLARE TSTB_ARR_ALLZERO ARRAY(4) BIT(16) INITIAL(HEX'0000');
  DECLARE TSTB_GUARD8 BIT(16) INITIAL(HEX'6668');
  DECLARE TSTB_ARR_MIXED ARRAY(4) BIT(16) INITIAL(
     HEX'A101',HEX'0000',HEX'A103',HEX'0000');
  DECLARE TSTB_GUARD9 BIT(16) INITIAL(HEX'6669');
  DECLARE TSTB_ARR_UNINIT ARRAY(4) BIT(16);
  DECLARE TSTB_GUARDA BIT(16) INITIAL(HEX'666A');
C  ---- structure with copiness, partly zero ----
 STRUCTURE TSTK_REC RIGID:
  1 FLD1 BIT(16),
  1 FLD2 BIT(16),
  1 FLD3 BIT(16);
  DECLARE TSTK_RECS TSTK_REC-STRUCTURE(3) INITIAL(
     HEX'B101',HEX'0000',HEX'B103',
     HEX'B201',HEX'0000',HEX'B203',
     HEX'B301',HEX'0000',HEX'B303');
  DECLARE TSTB_GUARDB BIT(16) INITIAL(HEX'666B');
  DECLARE TSTK_RECU TSTK_REC-STRUCTURE(2);
  DECLARE TSTB_GUARDC BIT(16) INITIAL(HEX'666C');
  CLOSE_TST: CLOSE;
