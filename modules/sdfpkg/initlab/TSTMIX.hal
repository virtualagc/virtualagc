  TST_MIX: COMPOOL RIGID;
C  Probe 5: structures mixing BIT with arithmetic fields, in a COMPOOL.
  DECLARE TSMB_GUARD1 BIT(16) INITIAL(HEX'AB01');
 STRUCTURE TSMK_REC RIGID:
  1 MFLD1 BIT(16),
  1 MFLD2 INTEGER,
  1 MFLD3 BIT(16),
  1 MFLD4 SCALAR;
C  fully initialized, three copies
  DECLARE TSMK_FULL TSMK_REC-STRUCTURE(3) INITIAL(
     HEX'C101',101,HEX'C103',1.5,
     HEX'C201',201,HEX'C203',2.5,
     HEX'C301',301,HEX'C303',3.5);
  DECLARE TSMB_GUARD2 BIT(16) INITIAL(HEX'AB02');
C  same shape, wholly uninitialized
  DECLARE TSMK_NONE TSMK_REC-STRUCTURE(2);
  DECLARE TSMB_GUARD3 BIT(16) INITIAL(HEX'AB03');
C  arithmetic scalars, initialized to zero and left uninitialized
  DECLARE TSMS_ZERO SCALAR INITIAL(0);
  DECLARE TSMS_UNINIT SCALAR;
  DECLARE TSMB_GUARD4 BIT(16) INITIAL(HEX'AB04');
  CLOSE_TSM: CLOSE;
