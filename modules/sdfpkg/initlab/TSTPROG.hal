  TSTPROG: PROGRAM;
C  Probe 4: does a PROGRAM/PROCEDURE/FUNCTION get its own init table?
  DECLARE TSRB_MAIN1 BIT(16) INITIAL(HEX'9991');
  DECLARE TSRB_MAIN2 BIT(16) INITIAL(HEX'9992');
  DECLARE TSRI_MAIN3 INTEGER INITIAL(4369);
  DECLARE TSRB_MAINU BIT(16);

  TSTPROC: PROCEDURE;
    DECLARE TSRB_PROC1 BIT(16) INITIAL(HEX'AAA1');
    DECLARE TSRB_PROC2 BIT(16) INITIAL(HEX'AAA2');
    DECLARE TSRB_PROCU BIT(16);
    TSRB_PROC1 = TSRB_PROC2;
  CLOSE TSTPROC;

  TSTFUNC: FUNCTION INTEGER;
    DECLARE TSRI_FUN1 INTEGER INITIAL(30001);
    DECLARE TSRB_FUN2 BIT(16) INITIAL(HEX'BBB2');
    RETURN TSRI_FUN1;
  CLOSE TSTFUNC;

  TSRB_MAIN1 = TSRB_MAIN2;
  CALL TSTPROC;
  TSRI_MAIN3 = TSTFUNC;
  CLOSE TSTPROG;
