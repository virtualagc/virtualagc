  TST_NAME: COMPOOL RIGID;
C  Probe 7: NAME pointers -- where the pointer lands and what it holds.
  DECLARE TSNB_GUARD1 BIT(16) INITIAL(HEX'9A01');
  DECLARE TSNI_TARGET1 INTEGER INITIAL(4660);
  DECLARE TSNB_GUARD2 BIT(16) INITIAL(HEX'9A02');
  DECLARE TSNI_TARGET2 INTEGER INITIAL(4661);
  DECLARE TSNB_GUARD3 BIT(16) INITIAL(HEX'9A03');
  DECLARE TSNP_PTR1 NAME INTEGER INITIAL(NAME(TSNI_TARGET1));
  DECLARE TSNB_GUARD4 BIT(16) INITIAL(HEX'9A04');
  DECLARE TSNP_PTR2 NAME INTEGER INITIAL(NAME(TSNI_TARGET2));
  DECLARE TSNB_GUARD5 BIT(16) INITIAL(HEX'9A05');
C  NAME terminals inside a structure with two copies
 STRUCTURE TSNK_REC RIGID:
  1 NFLD1 NAME INTEGER,
  1 NFLD2 NAME INTEGER;
  DECLARE TSNK_RECS TSNK_REC-STRUCTURE(2) INITIAL(
     NAME(TSNI_TARGET1),NAME(TSNI_TARGET2),
     NAME(TSNI_TARGET2),NAME(TSNI_TARGET1));
  DECLARE TSNB_GUARD6 BIT(16) INITIAL(HEX'9A06');
  CLOSE_TSN: CLOSE;
