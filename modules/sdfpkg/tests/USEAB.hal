D INCLUDE TEMPLATE COMPA
D INCLUDE TEMPLATE COMPB
 USEAB: PROGRAM;
    DECLARE T SCALAR;
    IA = 5;
    SA = 10.0;
    CA = 'GROK';
    ASTRUCTURE.SI = 12;
    IB = 75;
    SB = 50.0;
    CB = 'STRANGER';
    BSTRUCTURE.TI = 3;
    BSTRUCTURE.TS = 4.5;
    T = SA + SB + BSTRUCTURE.TS;
    WRITE(6) IA, CA, IB, CB, T, ASTRUCTURE.SI, BSTRUCTURE.TI;
 CLOSE USEAB;
