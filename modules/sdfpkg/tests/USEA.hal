D INCLUDE TEMPLATE COMPA
 USEA: PROGRAM;
    DECLARE LOCAL INTEGER;
    IA = 5;
    BA = BIT(22);
    SA = 10.0;
    CA = 'GROK';
    ASTRUCTURE.SI = 12;
    ASTRUCTURE.SL = FALSE;
    ASTRUCTURE.SS = 39.0;
    ASTRUCTURE.SC = 'HELLO';
    LOCAL = IA + ASTRUCTURE.SI;
    WRITE(6) IA, BA, SA, CA, LOCAL;
    WRITE(6) ASTRUCTURE.SI, ASTRUCTURE.SL, ASTRUCTURE.SS, ASTRUCTURE.SC;
 CLOSE USEA;
