C/ A second COMPOOL, for testing two SDF imports in one compilation.
 COMPB: COMPOOL;
    STRUCTURE BSTRUCTURE:
       1 TI INTEGER,
       1 TS SCALAR;
    DECLARE BSTRUCTURE BSTRUCTURE-STRUCTURE;
    DECLARE
        IB INTEGER,
        BB BIT(16),
        SB SCALAR,
        CB CHARACTER(30);
 CLOSE COMPB;
