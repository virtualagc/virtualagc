diff --git a/src/dfg/ddt.py b/src/dfg/ddt.py
index a86bbfe..f526bf7 100644
--- a/src/dfg/ddt.py
+++ b/src/dfg/ddt.py
@@ -258,7 +258,31 @@ _BLT6 = frozenset((
 # GROUP-level allowances added on top of the derived max-walk, keyed by
 # (display, rate-group ordinal).  Generator allowances only — the runtime
 # needs no more than the walk; the rule producing them is unknown.
-_RC_GROUP_ALLOWANCE = {("CG0500", 1): 2, ("CG0500", 2): 3}
+#
+# LOCAL WORKAROUND, not upstream.  PR #46 is open: 7d90b05 takes CS2050 to
+# 734/734 against the OI340700 dump and CS2120 to 883/884, leaving rate group
+# 0 at 211 where the dump says 213.  Three VPARM signatures occur in that
+# group and in no other dump-validated group -- HEX(9,8) B 3.0 H ZEROES=YES,
+# HEX(9,3) B 2.0 H ZEROES=NO and HEX(1,8) B 3.0 H ZEROES=YES, all ATTR=B
+# where the measured cases behind 7d90b05 are ATTR=H -- so the general rule
+# is unconstrained there and the shortfall cannot be attributed to an op.
+# Until it is, the allowance is empirical, and therefore per-release: the
+# table is keyed by display name and OI340600's CS2120 is an unrelated
+# 1068-halfword S/L DPA PERIPHERAL page, so a bare entry would corrupt
+# OI340600 builds.
+_RC_GROUP_ALLOWANCE_OI340600 = {("CG0500", 1): 2, ("CG0500", 2): 3}
+_RC_GROUP_ALLOWANCE_OI340700 = {("CG0500", 1): 2, ("CG0500", 2): 3,
+                                ("CS2120", 0): 2}
+_RC_RELEASES = {"OI340600": _RC_GROUP_ALLOWANCE_OI340600,
+                "OI340700": _RC_GROUP_ALLOWANCE_OI340700}
+_RC_GROUP_ALLOWANCE = _RC_GROUP_ALLOWANCE_OI340600
+
+
+def set_release(release):
+    """Select the release whose generator allowances to reproduce.  Raises
+    KeyError on an unknown release."""
+    global _RC_GROUP_ALLOWANCE
+    _RC_GROUP_ALLOWANCE = _RC_RELEASES[release]
 
 
