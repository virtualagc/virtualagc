 UPDPRIO: PROGRAM;
    LOWTASK: TASK;
       WRITE(6) 'LOW';
    CLOSE LOWTASK;
    HITASK: TASK;
       WRITE(6) 'HI';
    CLOSE HITASK;

    SCHEDULE LOWTASK PRIORITY(10), REPEAT EVERY 1.0;
    SCHEDULE HITASK PRIORITY(90), REPEAT EVERY 1.0;
    WAIT 2.5;
    UPDATE PRIORITY LOWTASK TO 200;
    WAIT 2.0;
    WRITE(6) 'DONE';
 CLOSE UPDPRIO;
