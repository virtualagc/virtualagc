 EVAND: PROGRAM;
    DECLARE EV1 EVENT LATCHED, EV2 EVENT LATCHED;
    A: TASK;
       WRITE(6) 'IN A';
       SET EV1;
    CLOSE A;
    B: TASK;
       WRITE(6) 'IN B';
       SET EV2;
    CLOSE B;

    WRITE(6) 'BEFORE';
    SCHEDULE A PRIORITY(80);
    SCHEDULE B PRIORITY(80);
    WAIT FOR EV1 & EV2;
    WRITE(6) 'DONE';
 CLOSE EVAND;
