 DEPCLOSE: PROGRAM;
    A: TASK;
       WRITE(6) 'IN A';
    CLOSE A;
    PARENT: TASK;
       WRITE(6) 'IN PARENT BEFORE';
       SCHEDULE A PRIORITY(80) DEPENDENT;
       WRITE(6) 'IN PARENT AFTER';
    CLOSE PARENT;

    WRITE(6) 'BEFORE';
    SCHEDULE PARENT PRIORITY(80);
    WAIT 1.0;
    WRITE(6) 'DONE';
 CLOSE DEPCLOSE;
