 ERRDYNS: PROGRAM;
    DECLARE SCALAR, NEG4 INITIAL(-4.0);
    DECLARE SCALAR, RESULT;

    P: FUNCTION;
       DECLARE SCALAR, PR;
       ON ERROR$(4:5) GO TO PCAUGHT;
       PR = SQRT(NEG4);
       WRITE(6) 'P SHOULD NOT PRINT', PR;
       RETURN PR;
       PCAUGHT: WRITE(6) 'P CAUGHT';
       RETURN 99.0;
    CLOSE P;

    RESULT = P;
    WRITE(6) 'AFTER CALL', RESULT;
    RESULT = SQRT(NEG4);
    WRITE(6) 'AFTER RETURN', RESULT;
 CLOSE ERRDYNS;
