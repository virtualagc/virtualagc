 CHARCMP: PROGRAM;
    DECLARE CHARACTER(10), C1 INITIAL('HELLO'), C2 INITIAL('HELLO');
    DECLARE CHARACTER(10), C3 INITIAL('WORLD');
    IF C1 = C2 THEN
       WRITE(6) 'EQUAL1';
    ELSE
       WRITE(6) 'NOTEQUAL1';
    IF C1 = C3 THEN
       WRITE(6) 'EQUAL2';
    ELSE
       WRITE(6) 'NOTEQUAL2';
 CLOSE CHARCMP;
