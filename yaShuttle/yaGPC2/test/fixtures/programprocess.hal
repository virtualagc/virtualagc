 SECOND: EXTERNAL PROGRAM;
 CLOSE SECOND;

 PRIMARY2: PROGRAM;
    IF SECOND THEN
       WRITE(6) 'SECOND ALREADY ACTIVE (SHOULD NOT PRINT)';
    ELSE
       WRITE(6) 'SECOND NOT YET ACTIVE (CORRECT)';
    SCHEDULE SECOND PRIORITY(80) DEPENDENT;
    IF SECOND THEN
       WRITE(6) 'SECOND NOW ACTIVE (CORRECT)';
    ELSE
       WRITE(6) 'SECOND NOT ACTIVE (SHOULD NOT PRINT)';
    WAIT FOR DEPENDENT;
    IF SECOND THEN
       WRITE(6) 'SECOND STILL ACTIVE (SHOULD NOT PRINT)';
    ELSE
       WRITE(6) 'SECOND INACTIVE AGAIN (CORRECT)';
    WRITE(6) 'PRIMARY2 DONE';
 CLOSE PRIMARY2;
