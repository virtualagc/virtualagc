 CANCEL2: PROGRAM;
    A: TASK;
       WRITE(6) 'IN A';
    CLOSE A;
    B: TASK;
       WRITE(6) 'IN B';
    CLOSE B;

    WRITE(6) 'BEFORE';
    SCHEDULE A PRIORITY(80), REPEAT EVERY 1.0;
    SCHEDULE B PRIORITY(80), REPEAT EVERY 1.0;
    CANCEL A, B;
    WAIT 1.0;
    WRITE(6) 'DONE';
 CLOSE CANCEL2;
