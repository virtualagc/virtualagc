 OFFERR2: PROGRAM;
    DECLARE SCALAR, NEG4 INITIAL(-4.0);
    DECLARE SCALAR, RESULT;

    ON ERROR$(4:5) GO TO CAUGHT;
    RESULT = SQRT(NEG4);
    WRITE(6) 'SHOULD NOT PRINT (first)';
    GO TO SKIP1;
    CAUGHT: WRITE(6) 'CAUGHT FIRST';
    SKIP1: OFF ERROR$(4:5);
    RESULT = SQRT(NEG4);
    WRITE(6) 'AFTER SECOND', RESULT;
 CLOSE OFFERR2;
