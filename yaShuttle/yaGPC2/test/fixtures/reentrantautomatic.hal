 REENT1: PROGRAM;
    DECLARE SCALAR, RA, RB;

    P: PROCEDURE(X) ASSIGN(Y) REENTRANT;
       DECLARE SCALAR, X, Y;
       DECLARE SCALAR AUTOMATIC, LOCAL;
       LOCAL = X;
       WAIT 1.0;
       Y = LOCAL;
    CLOSE P;

    TASKA: TASK;
       DECLARE SCALAR, TA;
       CALL P(10.0) ASSIGN(TA);
       WRITE(6) 'TASKA', TA;
    CLOSE TASKA;

    TASKB: TASK;
       DECLARE SCALAR, TB;
       WAIT 0.5;
       CALL P(20.0) ASSIGN(TB);
       WRITE(6) 'TASKB', TB;
    CLOSE TASKB;

    SCHEDULE TASKA PRIORITY(80);
    SCHEDULE TASKB PRIORITY(80);
    WAIT 5.0;
 CLOSE REENT1;
