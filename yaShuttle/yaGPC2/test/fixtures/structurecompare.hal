 STRUCCMP: PROGRAM;
    STRUCTURE Q:
       1 QI INTEGER,
       1 QS SCALAR;
    DECLARE A Q-STRUCTURE INITIAL(1, 2.0);
    DECLARE B Q-STRUCTURE INITIAL(1, 2.0);
    DECLARE C Q-STRUCTURE INITIAL(1, 3.0);
    IF A = B THEN
       WRITE(6) 'EQUAL1';
    ELSE
       WRITE(6) 'NOTEQUAL1';
    IF A = C THEN
       WRITE(6) 'EQUAL2';
    ELSE
       WRITE(6) 'NOTEQUAL2';
 CLOSE STRUCCMP;
