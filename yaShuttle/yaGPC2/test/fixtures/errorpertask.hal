 ERRPTASK: PROGRAM;
    DECLARE SCALAR, NEG4 INITIAL(-4.0);
    DECLARE SCALAR, RESULT;

    NEXT: TASK;
       DECLARE SCALAR, TR;
       ON ERROR$(4:5) GO TO TASKCAUGHT;
       TR = SQRT(NEG4);
       WRITE(6) 'TASK SHOULD NOT PRINT THIS', TR;
       GO TO TASKDONE;
       TASKCAUGHT: WRITE(6) 'TASK CAUGHT';
       TASKDONE: WRITE(6) 'TASK DONE';
    CLOSE NEXT;

    SCHEDULE NEXT PRIORITY(80);
    WAIT 0.5;
    RESULT = SQRT(NEG4);
    WRITE(6) 'PRIMAL UNCAUGHT', RESULT;
 CLOSE ERRPTASK;
