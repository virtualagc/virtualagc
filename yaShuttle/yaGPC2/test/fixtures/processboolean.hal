 PROCBOOL: PROGRAM;
    NEXT: TASK;
       WRITE(6) 'IN TASK';
    CLOSE NEXT;

    SCHEDULE NEXT PRIORITY(80), REPEAT EVERY 1.0;
    IF NEXT THEN
       WRITE(6) 'BEFORE ACTIVE';
    ELSE
       WRITE(6) 'BEFORE INACTIVE';
    TERMINATE NEXT;
    IF NEXT THEN
       WRITE(6) 'AFTER ACTIVE';
    ELSE
       WRITE(6) 'AFTER INACTIVE';
    WAIT 0.5;
 CLOSE PROCBOOL;
