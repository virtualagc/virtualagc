# NMakefile — yaGPC2 build for native Windows (nmake + MSVC's cl.exe),
# companion to the GNU `Makefile` used on Linux, macOS, and
# Windows-under-MSYS2 (see that file's header comment for the split
# rationale — nmake's syntax is different enough from GNU Make's that a
# single file covering both isn't practical).
#
# Usage (from a "Developer Command Prompt for VS" / "x64 Native Tools"
# shell, so cl.exe/nmake are on PATH):
#   nmake /f NMakefile
#   nmake /f NMakefile test
#   nmake /f NMakefile clean
#
# HOW THE POSIX CODE BUILDS HERE.  The sources are written to POSIX --
# pthreads, BSD sockets, clock_gettime, GCC's __atomic builtins -- and are
# compiled here unchanged.  src\win32\ supplies what MSVC lacks: its
# posix_compat.h is force-included into every file (/FI), the headers
# beside it answer for <pthread.h>, <unistd.h>, <strings.h>, <poll.h> and
# the socket headers (/I src\win32), and posix_win32.c holds the functions
# behind them.  See posix_compat.h.  The GNU Makefile never sees any of it.
#
# That is for cl.exe.  clang-cl is untried: it has the __atomic builtins
# itself, which posix_compat.h allows for, but nothing has been built with
# it.
#
# Known simplifications versus the GNU Makefile:
#   - The source list is written out, where the GNU Makefile takes
#     src/*.c by wildcard.  A NEW FILE IN src\ HAS TO BE ADDED TO `OBJS`
#     BELOW or the link fails with its symbols unresolved.
#   - No per-header incremental-rebuild tracking (GNU Make's
#     -MMD -MP-generated .d files have no simple nmake equivalent without
#     parsing cl.exe's /showIncludes output) — editing only a .h file
#     without touching its .c file may require `nmake clean` first.
#   - The test\*.sh scripts that `make test` runs first are bash and are
#     not run here; `nmake test` runs the C unit tests only.  Run the
#     scripts under WSL/MSYS2/Git Bash if needed.
#   - No POSIX real-time timers, so --pacing=signal is refused at run time
#     with a message, as on macOS.  --pacing=burst is the default.
#
# Requires ..\yaGpcIntegration\yaGpcIntegration.h to exist (the shared,
# single-copy contract header both yaGPC2 and yaHALMAT2 build against --
# see that file's own header comment) -- i.e. this repo must be checked
# out as a sibling of yaGpcIntegration\, same layout the GNU Makefile
# assumes. `lib.exe` (MSVC's librarian) ships alongside cl.exe/nmake in
# the same Developer Command Prompt, so no separate PATH setup is needed
# beyond what running this file at all already requires.

CC = cl

# yaGpcIntegration.h -- the shared, byte-for-byte contract between yaGPC2
# and yaHALMAT2 -- lives one directory up in the shared yaGpcIntegration\
# hub (single copy, not a per-repo duplicate), hence /I ..\yaGpcIntegration
# below (in addition to /I src for everything else).
INTEGRATION_DIR = ..\yaGpcIntegration

WIN32_DIR = src\win32

# /std:c11 needs VS2019 16.8+, and posix_compat.h's __typeof__ needs
# VS2022 17.9+. /W4 is the closest rough equivalent to the GNU build's
# -Wall -Wextra (not a precise match — MSVC's warning set differs from
# GCC/Clang's). /D_CRT_SECURE_NO_WARNINGS suppresses MSVC's deprecation
# warnings (C4996) for standard functions like fopen/sscanf in favor of
# its own nonstandard `_s` variants, and /D_CRT_NONSTDC_NO_WARNINGS the
# same for the POSIX names it would rather have underscored (fdopen,
# write) — this codebase intentionally stays on portable C rather than
# splitting onto MSVC-only APIs. No /TC: it makes cl read EVERY file on
# its command line as C source, the .obj and .lib files of a link
# included, and .c files are C without it. /DHAVE_PTHREADS because src\win32\pthread.h
# provides them; without it a vehicle of more than one computer is
# refused.
#
# The GNU build's -Werror=format has no equivalent that is an error only
# for printf conversions; C4477 and C4313 are cl's warnings for a
# conversion that does not match its argument, and /we makes them errors.
#
# Warnings switched off, each because the code is right and cl objects:
#   4324  a structure padded because a member is _Alignas(64) -- the point
#   4456  a local that hides an outer local  } -Wall -Wextra allow both,
#   4457  a local that hides a parameter     } and the code uses them
#   4706  assignment within a conditional expression
#   4127  a conditional expression that is constant (`for (;;)`, sizeof tests)
#   4146  unary minus on an unsigned value -- two's-complement negation,
#         which is what floatIBM.c means by it
#   4090  "different const qualifiers" passing a const table to qsort/free
#   4244  } an integer assigned to a narrower one where the value is known
#   4267  } to fit (a port number into a uint16_t, a count into a long) --
#         -Wconversion, which the GNU build does not ask for either
WARN = /W4 /we4477 /we4313 /wd4324 /wd4456 /wd4457 /wd4706 /wd4127 /wd4146 /wd4090 /wd4244 /wd4267
CFLAGS = /nologo /std:c11 $(WARN) /O2 /Zi /D_CRT_SECURE_NO_WARNINGS \
	/D_CRT_NONSTDC_NO_WARNINGS /DHAVE_PTHREADS \
	/FI posix_compat.h /I $(WIN32_DIR) /I src /I $(INTEGRATION_DIR)
LDFLAGS =
# Winsock, and timeBeginPeriod.
LDLIBS = ws2_32.lib winmm.lib

BUILD_DIR = build
TEST_BIN_DIR = $(BUILD_DIR)\test
BIN = yaGPC2.exe
# NOT `LIB`: nmake exports a macro that shares a name with an environment
# variable, and LIB is where link.exe looks for the C runtime.
LIBFILE = libyaGPC2.lib

# Everything except main.obj (the CLI's own entry point, which would
# clash with an integrator's own) -- mirrors the GNU Makefile's LIB_OBJS;
# see that file's own comment for the full rationale.  posix_win32.obj is
# part of it, so that an integrator links one library here too.
LIB_OBJS = \
	$(BUILD_DIR)\ageharness.obj \
	$(BUILD_DIR)\ap101.obj \
	$(BUILD_DIR)\bcenet_framer.obj \
	$(BUILD_DIR)\bcenet_transport.obj \
	$(BUILD_DIR)\compat.obj \
	$(BUILD_DIR)\cpu.obj \
	$(BUILD_DIR)\cpu_instr.obj \
	$(BUILD_DIR)\debugger.obj \
	$(BUILD_DIR)\deumodel.obj \
	$(BUILD_DIR)\discretes.obj \
	$(BUILD_DIR)\ebcdic.obj \
	$(BUILD_DIR)\envcache.obj \
	$(BUILD_DIR)\floatIBM.obj \
	$(BUILD_DIR)\gpcops.obj \
	$(BUILD_DIR)\halucp.obj \
	$(BUILD_DIR)\iccmodel.obj \
	$(BUILD_DIR)\iohost.obj \
	$(BUILD_DIR)\iop.obj \
	$(BUILD_DIR)\iop_bce_instr.obj \
	$(BUILD_DIR)\iop_msc_instr.obj \
	$(BUILD_DIR)\json.obj \
	$(BUILD_DIR)\mcm.obj \
	$(BUILD_DIR)\mdmdev.obj \
	$(BUILD_DIR)\startrk.obj \
	$(BUILD_DIR)\lpsmodel.obj \
	$(BUILD_DIR)\membus.obj \
	$(BUILD_DIR)\mmumodel.obj \
	$(BUILD_DIR)\mtumodel.obj \
	$(BUILD_DIR)\opts.obj \
	$(BUILD_DIR)\physics.obj \
	$(BUILD_DIR)\q31.obj \
	$(BUILD_DIR)\regmem.obj \
	$(BUILD_DIR)\rtpacer.obj \
	$(BUILD_DIR)\run.obj \
	$(BUILD_DIR)\schedule.obj \
	$(BUILD_DIR)\sourcemap.obj \
	$(BUILD_DIR)\strfmt.obj \
	$(BUILD_DIR)\symboltable.obj \
	$(BUILD_DIR)\timing.obj \
	$(BUILD_DIR)\trace.obj \
	$(BUILD_DIR)\util.obj \
	$(BUILD_DIR)\vehdyn.obj \
	$(BUILD_DIR)\vehicle.obj \
	$(BUILD_DIR)\volsource.obj \
	$(BUILD_DIR)\yaGpcEngineStatus.obj \
	$(BUILD_DIR)\posix_win32.obj

OBJS = $(BUILD_DIR)\main.obj $(LIB_OBJS)

all: $(BIN) $(LIBFILE)

$(BIN): $(BUILD_DIR) $(OBJS)
	$(CC) $(CFLAGS) /Fe:$(BIN) $(OBJS) $(LDLIBS) $(LDFLAGS)

$(LIBFILE): $(BUILD_DIR) $(LIB_OBJS)
	lib /nologo /out:$(LIBFILE) $(LIB_OBJS)

# Inference rule: build\X.obj from src\X.c.
{src}.c{$(BUILD_DIR)}.obj:
	$(CC) $(CFLAGS) /c /Fo:$@ $<

$(BUILD_DIR)\posix_win32.obj: $(WIN32_DIR)\posix_win32.c $(WIN32_DIR)\posix_compat.h
	$(CC) $(CFLAGS) /c /Fo:$@ $(WIN32_DIR)\posix_win32.c

$(BUILD_DIR):
	if not exist "$(BUILD_DIR)" mkdir "$(BUILD_DIR)"

$(TEST_BIN_DIR):
	if not exist "$(TEST_BIN_DIR)" mkdir "$(TEST_BIN_DIR)"

# ---------------------------------------------------------------------
# Unit tests — mirrors the GNU Makefile's per-test source lists
# (compiled+linked directly from source in one cl.exe invocation each,
# same as the GNU build does for these, so there's no separate .obj step
# to keep in sync here), with posix_win32.c added to each: the shims are
# force-included everywhere, so any of them may need the functions.
# ---------------------------------------------------------------------

UNIT_TESTS = \
	$(TEST_BIN_DIR)\test_packedbits.exe \
	$(TEST_BIN_DIR)\test_strfmt.exe \
	$(TEST_BIN_DIR)\test_ebcdic.exe \
	$(TEST_BIN_DIR)\test_q31.exe \
	$(TEST_BIN_DIR)\test_regmem.exe \
	$(TEST_BIN_DIR)\test_mcm_membus.exe \
	$(TEST_BIN_DIR)\test_floatIBM.exe \
	$(TEST_BIN_DIR)\test_cpu_ea.exe \
	$(TEST_BIN_DIR)\test_cpu_instr_decode.exe \
	$(TEST_BIN_DIR)\test_cpu_instr_exec.exe \
	$(TEST_BIN_DIR)\test_iop_bce_exec.exe \
	$(TEST_BIN_DIR)\test_iop_msc_exec.exe \
	$(TEST_BIN_DIR)\test_instr_tostr.exe \
	$(TEST_BIN_DIR)\test_iop_exec_processors.exe \
	$(TEST_BIN_DIR)\test_iop_discretes.exe \
	$(TEST_BIN_DIR)\test_discrete_rotation.exe \
	$(TEST_BIN_DIR)\test_gpcops.exe \
	$(TEST_BIN_DIR)\test_schedule.exe \
	$(TEST_BIN_DIR)\test_icc_queue.exe \
	$(TEST_BIN_DIR)\test_iop_dkbuses.exe \
	$(TEST_BIN_DIR)\test_bce_status.exe \
	$(TEST_BIN_DIR)\test_volsource.exe \
	$(TEST_BIN_DIR)\test_bcenet_txthread.exe \
	$(TEST_BIN_DIR)\test_mtumodel.exe \
	$(TEST_BIN_DIR)\test_mdmdev.exe \
	$(TEST_BIN_DIR)\test_physics.exe \
	$(TEST_BIN_DIR)\test_vehdyn.exe

# Every test RUNS, then the target fails if any of them did -- as the GNU
# Makefile's `test` does, and for its reason: one failure must not hide
# the tests behind it.  A failure leaves its name in FAILED.
FAILED = $(TEST_BIN_DIR)\FAILED

test: all $(TEST_BIN_DIR) $(UNIT_TESTS) $(TEST_BIN_DIR)\example_gpcops_paced_run.exe
	@if exist "$(FAILED)" del "$(FAILED)"
	@$(TEST_BIN_DIR)\test_packedbits.exe || echo test_packedbits>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_strfmt.exe || echo test_strfmt>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_ebcdic.exe || echo test_ebcdic>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_q31.exe || echo test_q31>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_regmem.exe || echo test_regmem>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_mcm_membus.exe || echo test_mcm_membus>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_floatIBM.exe || echo test_floatIBM>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_cpu_ea.exe || echo test_cpu_ea>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_cpu_instr_decode.exe || echo test_cpu_instr_decode>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_cpu_instr_exec.exe || echo test_cpu_instr_exec>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_iop_bce_exec.exe || echo test_iop_bce_exec>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_iop_msc_exec.exe || echo test_iop_msc_exec>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_instr_tostr.exe || echo test_instr_tostr>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_iop_exec_processors.exe || echo test_iop_exec_processors>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_iop_discretes.exe || echo test_iop_discretes>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_discrete_rotation.exe || echo test_discrete_rotation>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_gpcops.exe || echo test_gpcops>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_schedule.exe || echo test_schedule>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_icc_queue.exe || echo test_icc_queue>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_iop_dkbuses.exe || echo test_iop_dkbuses>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_bce_status.exe || echo test_bce_status>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_volsource.exe || echo test_volsource>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_bcenet_txthread.exe || echo test_bcenet_txthread>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_mtumodel.exe || echo test_mtumodel>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_mdmdev.exe || echo test_mdmdev>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_physics.exe || echo test_physics>> "$(FAILED)"
	@$(TEST_BIN_DIR)\test_vehdyn.exe || echo test_vehdyn>> "$(FAILED)"
	@$(TEST_BIN_DIR)\example_gpcops_paced_run.exe || echo example_gpcops_paced_run>> "$(FAILED)"
	@if exist "$(FAILED)" (echo. & echo FAILED STAGES: & type "$(FAILED)" & exit /b 1)
	@echo.
	@echo nmake test: every unit test passed

W32 = $(WIN32_DIR)\posix_win32.c
