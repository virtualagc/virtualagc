clean:
	if exist "$(BUILD_DIR)" rmdir /s /q "$(BUILD_DIR)"
	if exist "$(BIN)" del "$(BIN)"
	if exist "$(LIBFILE)" del "$(LIBFILE)"
	if exist "*.pdb" del "*.pdb"
	if exist "*.ilk" del "*.ilk"
