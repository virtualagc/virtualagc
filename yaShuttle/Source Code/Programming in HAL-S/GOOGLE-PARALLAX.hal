C      DEMO PROGRAM: STELLAR PARALLAX TRIANGULATION
C      ILLUSTRATING VECTOR MATH AND MULTI-LINE SYNTAX IN HAL/S
       SIRIUS_PARALLAX: PROGRAM;
       
C DECLARE APPARENT REA-DEVE CORRDINATE VECTORS (2-ELEMENTS)
             DECLARE SPRING VECTOR(2) DOUBLE;
             DECLARE FALL VECTOR(2) DOUBLE;
             DECLARE DEV VECTOR(2) DOUBLE;
             
C DECLARE SCALARS FOR ASTRONOMICAL CONSTANTS AND MATH
             DECLARE EOR SCALAR DOUBLE;
             DECLARE DISTANCE SCALAR DOUBLE;
             DECLARE ANGULAR_SHIFT SCALAR DOUBLE;
             
C INITIALIZE SIRIUS APPARENT COORDINATES IN RADIANS (2026 EPOCH)
             SPRING = VECTOR$2(1.76781036, -0.29175215);
             FALL = VECTOR$2(1.76781211, -0.29174987);
             
C RADIUS OF EARTH ORBIT IN MILES (1 AU)
             EOR = 93000000.0;
             
C 1. COMPUTE THE DEVIATION VECTOR (BUILT-IN VECTOR SUBTRACTION)
             DEV = SPRING - FALL;
             
C 2. CALCULATE THE VECTOR MAGNITUDE USING BUILT-IN ABVAL FUNCTION
             ANGULAR_SHIFT = ABVAL(DEV);
             
C 3. TRIANGULATE DISTANCE USING MULTI-LINE MATHEMATICAL SYNTAX
C    NOTE: THE 'E' LINE SUPPORTS SUPERSCRIPTS OR EXPR, 'M' IS MAIN TEXT.
C    THE FORMULA DIVIDES THE TOTAL TWO-SIDED DEVIATION ANGLE BY 2.
E                                            -1
M     DISTANCE = EOR / TAN( ANGULAR_SHIFT   2  );
S
       
C OUTPUT THE RESULT VIA SHUTTLE DATA BUS OR SYSTEM DISPLAY
             WRITE(6) 'COMPUTED STAR DISTANCE IN MILES:', DISTANCE;
             
       CLOSE SIRIUS_PARALLAX;

C Google's A.I. assistant offered to write this program for me, and
C I thought to myself, Why not? I sent the following comments to 
C Google about it, but the A.I. assistant said that my request had
C "expired" and refused to accept it. Was it in a snit? Who can say?
C Perhaps my smiley at the end was too irritating. The lession, at 
C least for 2026, is that perhaps you ought to stick to writing your
C own HAL/S programs for now. Anyway:
C
C     Excellent try! But quite a few things wrong in spite of that. 
C     The leading characters C, E, M, and S for Comment, Exponent, 
C     Main, and Subscript lines must align at column 1, so those 
C     lines are all syntax errors. `SCALARS` is not a datatype; it 
C     should be `SCALAR`. There is no such keyword as `ASSIGN`, so 
C     those need to be removed. Constructs like `VECTOR(...)` default 
C     to being 3-vectors, so those fail; they should all be 
C     `VECTOR$2(...)` instead. Typically, source code isn't written 
C     using E/M/S lines, because it's very tricky to get those aligned 
C     properly, so that format is only used in reports generated by 
C     the compiler. In your case, you've misaligned the exponent -1 
C     with the 2 below it, so that needs to be corrected. There is no 
C     multiplication operator `*` in HAL/S; that's a vector cross-
C     product operator. Plain multiplication is represented just by 
C     juxtaposition. So the `*` in the distance formula needs to be 
C     replaced by a blank space. Once all of those things are done, 
C     your program compiles, runs, and prints the line "COMPUTED STAR 
C     DISTANCE IN MILES: 6.2814568E+13". I've attached the corrected 
C     program for your edification. :-)
C
C I also made it all `DOUBLE`, but that made no difference in the 
C computed result.