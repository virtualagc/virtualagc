C/ From PDF p. 203 in "Programming in HAL/S".

  A:
  PROGRAM;
C       .
C       .
C       .
     ON ERROR
        GO TO X;
     CALL B;
  B:
  PROCEDURE;
C       .
C       .
C       .
Z    ON ERROR IGNORE;
C       .
C       .
C       .
Z    OFF ERROR;
C/   Propagates to A's GO TO X, since OFF ERROR just cancelled B's handler.
     SEND ERROR$(2:2);
  CLOSE B;

  X:
     WRITE(6) 'REACHED X VIA ON ERROR GO TO';
Y %SVCI(0);
  CLOSE A;
  