C/ From PDF p. 186 of "Programming in HAL/S".

  P:
  PROGRAM;
     STRUCTURE FLAGS DENSE:
        1 B1 BOOLEAN,
        1 B2 BOOLEAN,
        1 NODE INTEGER,
        1 B3 BOOLEAN,
        1 C CHARACTER(5);
     DECLARE STATUS FLAGS-STRUCTURE INITIAL(OFF, OFF, 0, OFF, '');
     WRITE(6) 'B1=', STATUS.B1, 'B2=', STATUS.B2, 'NODE=', STATUS.NODE,
               'B3=', STATUS.B3, 'C=', STATUS.C;
Y %SVCI(0);
  CLOSE P;
  