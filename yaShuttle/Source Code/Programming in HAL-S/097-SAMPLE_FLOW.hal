C/ From PDF p. 97 of "Programming in HAL/S".

  SAMPLE_FLOW:
  PROGRAM;
     DECLARE INTEGER,
             I INITIAL(0), J INITIAL(2),
             K INITIAL(0), L INITIAL(0), M INITIAL(3), N INITIAL(4);
     DO UNTIL FALSE;
        IF I = 0 THEN
           DO;
              J = 0;
              I = I - 1;
              WRITE(6) 'REPEATING OUTER LOOP, J SET TO', J;
              REPEAT;
           END;
        ELSE
           EXIT;
  LOOP2:
        DO FOR K = 1 TO 10;
    LOOP3: DO FOR L = M, N, M + N;
              IF J = 0 THEN
                 REPEAT LOOP2;
              ELSE
                 EXIT;
           END;
        END;
     END;
     WRITE(6) 'FINAL: I=', I, 'J=', J, 'K=', K, 'L=', L;
Y %SVCI(0);
  CLOSE SAMPLE_FLOW;
  