C/ From PDF p. 222 of "Programming in HAL/S".

  MULTI:
  PROGRAM;
     DECLARE SCALAR,
                A, B, C INITIAL(20);
                
C       .
C       .
C       .

     IF A NOT = 0 THEN
        DO;
           B = C / A;
           
C       .
C       .
C       .

        END;
     WRITE(6) 'A=', A, 'B=', B, 'C=', C;
  T:
  TASK;
     A = 0;
Y %SVCI(0);
  CLOSE T;
Y %SVCI(0);
  CLOSE MULTI;
  