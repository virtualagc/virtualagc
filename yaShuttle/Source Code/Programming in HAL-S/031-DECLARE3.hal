C/ From PDF p. 31 of "Programming in HAL/S".

  DECLARE3:
  PROGRAM;
     DECLARE COUNTER INTEGER;
     DECLARE VECTOR,
                POSITION, VELOCITY, TORQUE;
     DECLARE NEW_CO_ORDS MATRIX,
             SPEED SCALAR,
             N INTEGER,
             WIND_FORCE VECTOR;
     COUNTER = 3;
     SPEED = 100;
     N = 5;
     POSITION = VECTOR(1, 2, 3);
     WRITE(6) 'COUNTER=', COUNTER, 'SPEED=', SPEED, 'N=', N;
     WRITE(6) 'POSITION=', POSITION;
Y %SVCI(0);
  CLOSE DECLARE3;
  