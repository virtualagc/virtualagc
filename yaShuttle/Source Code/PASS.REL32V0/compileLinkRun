#!/usr/bin/env python
# Compile, link, and run a HAL/S program, using HALSFC, lnk101, and gpc-batch.

import sys
import subprocess
import os
from pathlib import Path

extraParms = ""
def getParms(filename):
    parmBase = extraParms + "LIST,SRN,TEMPLATE,NOLFXI,REGOPT,VARSYM,CARDTYPE="
    cardtypesBySourceFile = {
        "CS2INI" : "ACFCRMYCZM",
        "CS4INI" : "ACFCRMYCZM",
        "CPTOSV" : "ACBDFCRMYCZM",
        "CPUSLS" : "ACBDFCRMYCZM",
        "GKDASC": "AMOCNCRMFDGCHCYCZM",
        "GKRORB": "ACOMNCRCFCGDHCYCZM",
        "GKGMNV": "ACOCNMRMFCGCHDYCZM"
        }
    cardtype = "FCRMYCZM"
    for name in cardtypesBySourceFile:
        if name in filename:
            cardtype = cardtypesBySourceFile[name]
            break
    return parmBase + cardtype

helpMsg = '''
Used for compiling, linking, running a standalone program implemented in a 
single HAL/S file.

Usage:
     compileLinkRun [OPTIONS] --filename=F
     
The available OPTIONs are:
    --filename=F    Required.  F is the path to the HAL/S source-code file.
    --parms=P       P is a list of HAL/S-FC compiler options that will 
                    completely override the defaults used by this program.
    --extra-parms=P P is a list of extra HAL/S-FC compiler options that will
                    be prefixed to the defaults used by this program.  P should
                    end in a comma.  
    --extra-pass1=P A list of extra "modern" command-line parameters passed to
                    the HALSFC.  The extra parameters should be 
                    separated by spaces, and should not themselves contain 
                    spaces (even if quoted).  Example: 
                            --extra-pass1="--pretty-bnf --verbose"
    --interactive   In running the compiled program, it is assumed by default
                    that the program does not require interactive user input
                    (via READ(5)), so output (from WRITE(6)) is captured and
                    printed out in a way that removes any extraneous messages
                    from the emulator.  If `--interactive` is used, the raw
                    output from the emulator is displayed, and user input can
                    be supplied via READ(5).  This distinction is primarily
                    to work around deficiencies in the emulator that are
                    hopefully temporary in nature while development of it
                    proceeds.
    --no-test       Do not use HALSFC's --test option.
    --debug         Pass the --debug switch to the emulator.
    --gpc           Use "gpc run ..." as the emulator command.
    --yaGPC         Use `yaGPC ...` as the emulator command.
    --yaGPC2        (The default.) Use `yaGPC2 ...` as the emulator command.
'''

filename = None
parmList = None
interactive = True
extraPass1 = []
noTest = False
debug = False
gpcCommand = ["yaGPC2"]
for parameter in sys.argv[1:]:
    if parameter.startswith("--parms="):
        parmList = parameter[8:]
    elif parameter.startswith("--extra-parms="):
        extraParms = parameter[14:]
    elif parameter.startswith("--extra-pass1="):
        extraPass1 = parameter[14:].strip().split()
    elif parameter.startswith("--filename="):
        filename = parameter[11:].replace("~", "$HOME")
    elif parameter == "--interactive":
        interactive = True
    elif parameter == "--no-test":
        noTest = True
    elif parameter == "--yaGPC":
        gpcCommand = ["yaGPC"]
    elif parameter == "--yaGPC3":
        gpcCommand = ["yaGPC3"]
    elif parameter == "--gpc":
        gpcCommand = ["gpc", "run"]
    elif parameter == "--debug":
        debug = True
    else:
        print(helpMsg)
        sys.exit(1)
if debug:
    gpcCommand.append("--debug")
if parmList == None:
    parmList = getParms(filename)
basename = Path(filename).stem
objfile = f"{basename}.obj"
fcmfile = f"{basename}.fcm"
symfile = f"{basename}-lnk101.json"
print(f"For file {basename}.hal, producing {objfile}, {fcmfile}, {symfile}")
filename = os.path.expanduser(os.path.expandvars(filename))

# First step, compile.
command = ["HALSFC", filename, f"--parms={parmList}", "-o", objfile]
if not noTest:
    command += ["--test", "--force", "--clean", "--archive"]
command += extraPass1
print(" ".join(command))
try:
    result = subprocess.run(command, capture_output = True, text = True, check = True)
    print(result.stdout)
except subprocess.CalledProcessError as e:
    print(f"Compilation failed with exit code {e.returncode}.")
    print("STDOUT:", e.stdout)
    print("STDERR:", e.stderr)
    os._exit(1)

# Next, link.
command = ["lnk101", objfile, "-o", fcmfile, "--json-symbols", symfile]
print(" ".join(command))
try:
    result = subprocess.run(command, capture_output = True, text = True, check = True)
except subprocess.CalledProcessError as e:
    print(f"Linking failed with exit code {e.returncode}.")
    print("STDOUT:", e.stdout)
    print("STDERR:", e.stderr)
    #os._exit(1)
    command = ["rldanalyze", symfile, fcmfile, f"../{config}.fcm", 
               "--csect-table", "../csects-{config}.json", "--show-gaps", 
               "--show-csects", "--scan-gaps"]
    print(" ".join(command))
    try:
        result = subprocess.run(command, capture_output = True, text = True, check = True)
    except subprocess.CalledProcessError as e:
        print(f"rldanalyze failed with exit code {e.returncode}.")
        print("STDOUT:", e.stdout)
        print("STDERR:", e.stderr)
    os._exit(1)

# Next, build a HAL/S source-line map for yaGPC2's --debug --source-map
# (see yaGPC2/tools/gen_source_map.py), from the pass1.rpt/pass2.rpt
# reports HALSFC just wrote to the current directory plus the linker's
# own section table. Only yaGPC2 understands --source-map, and only
# when gpcCommand[0] is actually "yaGPC2" is yaGPC2 the emulator that's
# about to be invoked below -- skipped entirely otherwise. Non-fatal if
# it fails: source-line display is a debugger nicety, not a requirement
# for compiling, linking, and running the program.
#
# gen_source_map.py's --unit takes MODULE=PASS1_PATH:PASS2_PATH and can
# repeat (a linked image is in general the result of linking many
# separately-compiled HAL/S units, not just the one compiled here) --
# this script only ever compiles a single file, so it always passes
# exactly one --unit; a real multi-unit link needs its own driver.
srcmapfile = f"{basename}.srcmap.json"
haveSrcmap = False
if gpcCommand[0] == "yaGPC2":
    command = ["gen_source_map.py",
               "--unit", f"{basename}=current.results/pass1.rpt:current.results/pass2.rpt",
               "--lnk101", symfile,
               "-o", srcmapfile]
    print(" ".join(command))
    try:
        result = subprocess.run(command, capture_output = True, text = True, check = True)
        print(result.stdout)
        haveSrcmap = True
    except subprocess.CalledProcessError as e:
        print(f"Source-map generation failed with exit code {e.returncode} (continuing without it).")
        print("STDOUT:", e.stdout)
        print("STDERR:", e.stderr)

# Next, run it in the emulator.
command = gpcCommand + ["--interactive",
	   "--no-trace", "--no-verbose",
	   "--symbols", symfile,
	   "--line-width", "240"]
if haveSrcmap:
    command += ["--source-map", srcmapfile]
command += [fcmfile]
print(" ".join(command))
if interactive:
    result = subprocess.run(command)
else:
    try:
        result = subprocess.run(command, capture_output = True, text = True, check = True)
        #print("STDOUT:", result.stdout)
        #print("STDERR:", result.stderr)
        print("Emulation output --------------------------------------------------")
        lines = result.stdout.split("\n")
        for line in lines:
            if line.startswith("OUTPUT(6)"):
                print(line[11:])
        print("-------------------------------------------------------------------")
    except subprocess.CalledProcessError as e:
        #print(f"Comparison failed with exit code {e.returncode}.")
        print("STDOUT:", e.stdout)
        print("STDERR:", e.stderr)
        #os._exit(1)
# Cleanup:
try:
        os.remove(objfile)
except:
        pass
try:
        os.remove(fcmfile)
except:
        pass
try:
        symfile = f"{basename}-lnk101.json"
except:
        pass
try:
        symfile = f"{basename}-lnk101.repro.json"
except:
        pass
try:
        symfile = f"{fcmfile}.LIST"
except:
        pass

