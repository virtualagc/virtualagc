# Did a compiler pass fail?
#
# The compiled passes follow the OS/360 convention that the HAL/S-FC XPL is
# written to: RETURN's value from the program's outermost scope is
# SHL(MAX_SEVERITY,2), the severity times 4.  So 0 is clean, 4 is warnings, 8
# is errors, and so on up.  The compiler's own rule for whether a compilation
# is still viable is MAX_SEVERITY < 2 -- PASS1 chains to the next pass on
# exactly that test, and otherwise forces MAX_SEVERITY to 4 and declares
# "COMPILATION ABANDONED".  Below 8 is therefore tolerable and 8 or above is
# not.  A severity-1 warning is the common case here: OPT's ZO3 sets
# SEVERITY_ONE, which makes PASS2 return 4, and treating that as fatal would
# throw away a perfectly good object module and, worse, skip PASS3 so that no
# SDF is written for anything downstream to include.
#
# Statuses that are not severities stay fatal by construction, being >= 8:
# XCOM-I's runtime library abends with 255, XPL's CALL EXIT gives 10, and
# HALSFC's own diagnoses are 240-254.
#
# Note that os.system() hands back a wait status rather than an exit status,
# so the exit code is in the high byte and a fatal signal is in the low byte.
#
# This applies only to the compiled passes.  HAL_S_FC.py, the Python port of
# PASS1, has no such convention -- its EXIT() is a plain sys.exit(1) -- so its
# result is still tested against zero.
def passFailed(exitCode):
    if exitCode & 0xFF:  # Died on a signal.
        return True
    return (exitCode >> 8) >= 8

# The arguments comprise an error message.
def errorExit(message):
    print(message)
    moveAll("%s: %s" % (message, commandLine))
    sys.exit(EXIT_PASS_FAILED)

# Adapted this from google AI.
def findFileUsingPATH(filename):
    pathVar = os.getenv("PATH")
    if not pathVar:
        return None
    directories = pathVar.split(os.pathsep)
    for directory in directories:
        if os.path.isfile(os.path.join(directory, filename)):
            return directory
    return None

