# Everything the compiler is told about by name, rather than finding in the
# working directory, is resolved against the directory HALSFC was run from.
# That is where the source file, the libraries and the object file belong,
# and under --concurrent it is no longer the directory the passes run in.
# Resolving unconditionally keeps the two cases identical but for the chdir.
invocationDir = os.getcwd()


def fromInvocation(path):
    if path == None:
        return None
    if os.path.isabs(path):
        return path
    return os.path.normpath(os.path.join(invocationDir, path))


halsFileAbs = fromInvocation(halsFile)
objectFilenameAbs = fromInvocation(objectFilename)
sdfiAbs = fromInvocation(sdfi)
