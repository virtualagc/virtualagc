                       "INCLIB", "INCLIBB", "SDFLIB"]
if clean:
    filesLocal += filesPreserve
    filesPreserve = []

# A private working directory, so that two HALSFCs can run at once in the
# same place.  It is created inside the results directory and *becomes* the
# results directory at the end, by being renamed: nothing is then moved file
# by file, and a run that dies leaves its workfiles where they can be looked
# at rather than half-moved.
workDir = None
if concurrent:
    archiveDir = os.path.join(invocationDir, "archive.results")
    os.makedirs(archiveDir, exist_ok=True)
    workDir = tempfile.mkdtemp(prefix="HALSFC-", dir=archiveDir)
    os.chdir(workDir)
else:
    # The deletions below are for the workfiles of a *previous* run in this
    # directory, and are exactly what makes two simultaneous runs impossible:
    # the second one's startup deletes the first one's files out from under
    # it.  Under --concurrent the working directory is new and empty, so
    # there is nothing to delete and nothing that may be deleted.
    for f in filesPorted+filesLocal+filesPreserve:
        try:
            os.remove(f)
        except:
            pass

# Copy the object file(s) out to wherever -o asked for them.  Under
# --concurrent the destination is in the invocation directory while the
# working directory is elsewhere, so the destination is always the resolved
# one, and "cards.bin" (or "cards") is never copied onto itself.
def copyObject():
    try:
        if bfs:
            if objectFilenameAbs != os.path.join(invocationDir, "cards"):
                try:
                    shutil.rmtree(objectFilenameAbs)
                except:
                    pass
                shutil.copytree("cards", objectFilenameAbs)
        else:
            if objectFilenameAbs != os.path.join(invocationDir, "cards.bin"):
                shutil.copy("cards.bin", objectFilenameAbs)
    except:
        print(f"FYI: Unable to copy object file(s) to {objectFilename}")


# Move all generated files to a *.results folder.
results = ""
def moveAll(message):
    global results
    if concurrent:
        # The working directory already holds everything a results directory
        # would be given, so it becomes one by being renamed.  Nothing is
        # left in the invocation directory to move, and the libraries are
        # deliberately not snapshotted into the results: copying a library
        # that another compilation may be stowing into would be both racy and
        # a misleading record of what this compilation saw.
        with open("comment.txt", "w") as f:
            print(message, file=f)
        copyObject()
        # The source file lives in the invocation directory, so it is brought
        # in for the record -- or moved in, if it is a preprocessor's
        # throwaway, as the underscore convention marks.
        try:
            if normFile.startswith("_"):
                shutil.move(halsFileAbs, normFile)
            else:
                shutil.copy(halsFileAbs, normFile)
        except:
            pass
        # The name is the same one a serial run would use, with a suffix if
        # some other run took it first: the timestamp is only to the second,
        # so two compilations of one file can easily share it.
        stem = os.path.join(archiveDir, "HALSFC %s %s.results" % (normFile, now))
        os.chdir(invocationDir)
        results = stem
        i = 0
        while os.path.exists(results):
            i += 1
            if i > 999:
                break
            results = "%s.%d" % (stem, i)
        try:
            os.rename(workDir, results)
        except OSError:
            results = workDir  # Leave it where it is, and say where that is.
        # Reported the way a serial run reports it, relative to where HALSFC
        # was run, rather than as the absolute path it is carried around as.
        results = os.path.relpath(results, invocationDir)
        print(f"Results stored in the folder \"{results}\".")
        return
    results = "HALSFC %s %s.results" % (normFile, now)
    if archive:
        try:
            os.mkdir("archive.results")
        except:
            pass
        results = f"archive.results{os.sep}{results}"
    os.mkdir(results);
    f = open("%s%scomment.txt" % (results, os.sep), "w")
    print(message, file=f)
    f.close()
    copyObject()
    if halsFile.startswith("_") or halsFile.startswith(f".{os.sep}_"):
        extras1 = [halsFile]
        extras2 = []
    else:
        extras1 = []
        extras2 = [halsFile]
    for f in filesPorted+filesLocal + extras1:
        try:
            shutil.move(f, "%s%s%s" % (results, os.sep, f))
        except:
            pass
    for f in filesPreserve+filesReallyPreserve+extras2:
        try:
            shutil.copy(f, "%s%s%s" % (results, os.sep, f))
        except:
            pass
    for d in dirsReallyPreserve:
        try:
            shutil.copytree(d, "%s%s%s" % (results, os.sep, d))
        except:
            pass
    print(f"Results stored in the folder \"{results}\".")
    numBackups = 2
    previous = ""
    for i in range(numBackups, 0, -1):
        try:
            os.remove(f"current-{i}.results")
        except:
            pass
        if i == 1:
            dest = ""
        else:
            dest = f"-{i-1}"
        try:
            shutil.move(f"current{dest}.results", f"current-{i}.results")
            if previous == "":
                previous = f"\"current-{i}.results\""
            else:
                previous = f"\"current-{i}.results\", {previous}"
        except:
            pass
    try:
        os.symlink(results, "current.results", target_is_directory=True)
        print("Accessible also as \"current.results\" until next HALSFC run.")
        if previous != "":
            print(f"For previous runs see also {previous}.")
    except:
        pass

# Did a compiler pass fail?
#
# The compiled passes follow the OS/360 convention that the HAL/S-FC XPL is
# written to: RETURN's value from the program's outermost scope is
# SHL(MAX_SEVERITY,2), the severity times 4.  So 0 is clean, 4 is warnings, 8
# is errors, and so on up.  The compiler's own rule for whether a compilation
# is still viable is MAX_SEVERITY < 2 -- PASS1 chains to the next pass on
# exactly that test, and otherwise forces MAX_SEVERITY to 4 and declares
# "COMPILATION ABANDONED".  Below 8 is therefore tolerable and 8 or above is
# not.  A severity-1 warning is the common case here: OPT's ZO3 sets
# SEVERITY_ONE, which makes PASS2 return 4, and treating that as fatal would
# throw away a perfectly good object module and, worse, skip PASS3 so that no
# SDF is written for anything downstream to include.
#
# Statuses that are not severities stay fatal by construction, being >= 8:
# XCOM-I's runtime library abends with 255, XPL's CALL EXIT gives 10, and
# HALSFC's own diagnoses are 240-254.
#
# Note that os.system() hands back a wait status rather than an exit status,
# so the exit code is in the high byte and a fatal signal is in the low byte.
#
# This applies only to the compiled passes.  HAL_S_FC.py, the Python port of
# PASS1, has no such convention -- its EXIT() is a plain sys.exit(1) -- so its
# result is still tested against zero.
def passFailed(exitCode):
    if exitCode & 0xFF:  # Died on a signal.
        return True
    return (exitCode >> 8) >= 8

# The arguments comprise an error message.
def errorExit(message):
    print(message)
    moveAll("%s: %s" % (message, commandLine))
    sys.exit(EXIT_PASS_FAILED)

# Adapted this from google AI.
def findFileUsingPATH(filename):
    pathVar = os.getenv("PATH")
    if not pathVar:
        return None
    directories = pathVar.split(os.pathsep)
    for directory in directories:
        if os.path.isfile(os.path.join(directory, filename)):
            return directory
    return None

if bfs:
    PASS1 = "HALSFC-PASS1B" + ext
    FLO = "HALSFC-FLO" + ext
    OPT = "HALSFC-OPTB" + ext
    AUXP = "HALSFC-AUXP" + ext
    PASS2 = "HALSFC-PASS2B" + ext
    PASS3 = "HALSFC-PASS3B" + ext
    PASS4 = "HALSFC-PASS4" + ext
    TEMPLIB = "TEMPLIBB"
    TEMPLIBP = "TEMPLIBBp"
    INCLIB = "INCLIBB"
    INCLIB2 = "&&TEMPINC"
    CARDS = "--pdso=3,cards,E"
    TARGET = "--bfs"
else:
    PASS1 = "HALSFC-PASS1" + ext
    FLO = "HALSFC-FLO" + ext
    OPT = "HALSFC-OPT" + ext
    AUXP = "HALSFC-AUXP" + ext
    PASS2 = "HALSFC-PASS2" + ext
    PASS3 = "HALSFC-PASS3" + ext
    PASS4 = "HALSFC-PASS4" + ext
    TEMPLIB = "TEMPLIB"
    TEMPLIBP = "TEMPLIBp"
    INCLIB = "INCLIB"
    INCLIB2 = "&&TEMPINC"
    CARDS = "--ddo=3,cards.bin,E"
    TARGET = "--pfs"

appDir = findFileUsingPATH(PASS1)
if appDir == None:
    print("Directory containing the compiler is not in the PATH")
    sys.exit(EXIT_ENVIRONMENT)
ERRORLIB = appDir + os.sep + "ERRORLIB"
# The libraries persist from one compilation to the next, so they belong to
# the invocation directory rather than to whatever directory the passes
# happen to run in.  TEMPLIBP is HAL_S_FC.py's own copy of the template
# library: it is written as well as read, and both compilers bumping the same
# version codes would be two writers of one member.
TEMPLIBABS = fromInvocation(TEMPLIB)
TEMPLIBPABS = fromInvocation(TEMPLIBP)
INCLIBABS = fromInvocation(INCLIB)
# ACCESS, the PDS of module access rights, is looked for where HALSFC was run
# and otherwise alongside the compiler, which is where the installation keeps
# it.  Resolving it matters because the passes no longer necessarily run in
# the directory it is in.
ACCESSABS = fromInvocation("ACCESS")
if not os.path.isdir(ACCESSABS):
    ACCESSABS = appDir + os.sep + "ACCESS"
parmList = parmString.split(",")
# An SDF library to import from, for PASS1 and for HAL_S_FC.py alike.  PASS3
# writes to SDFLIB by default whether or not this is given; --sdfi is only
# about reading them back in place of TEMPLATEs.
if sdfi == None:
    sdfiSwitch = ""
else:
    sdfiSwitch = '--sdfi="%s"' % sdfiAbs

# Run PASS1.
command ='''%s
 --parm="%s"
 --ddi=0,"%s"
 --ddo=2,listing2.txt
 --pdsi=4,"%s",E
 --pdsi=5,"%s"
 --pdsi=6,"%s"
 --pdso=6,"%s",E
 --pdsi=8,"%s",E
 --pdso=8,"%s",E
 --pdsi=9,"%s",E
 --commono=COMMON0%s
 --raf=O,7200,1,halmat.bin
 --raf=B,1560,2,litfile.bin
 --raf=B,1600,3,icfile.bin
 --raf=B,3360,6,vmem.bin
 %s
 %s
 %s
 %s
 >pass1.rpt''' % (PASS1, parmString, halsFileAbs, TEMPLIBABS, ERRORLIB,
                 ACCESSABS, TEMPLIBABS, INCLIBABS, INCLIB2, INCLIB2,
                 extCOMMON, debugX, rsbTrace, prettyBNF, sdfiSwitch)
#print(f"Here {command}", file=sys.stderr)
command = command.replace("\n", "")
if verbose:
    print(command)
exitCode = os.system(command)
pendingFailure = None
if passFailed(exitCode):
    if test and force:
        print("HALSFC-PASS1 has failed, but --test will be performed anyway.")
        pendingFailure = "HALSFC-PASS1 failure"
    else:
        errorExit("Aborted after PASS1")
# Guarded, because an unguarded copy of a missing intermediate reports itself as
# a bare Python traceback rather than as a compilation problem.  A stale work
# directory -- two compilations having run in it at once -- made this fail for
# one file of a corpus run, and the traceback read as a defect in the compiler
# option being tested rather than as the leftover state it actually was.
if os.path.exists("litfile.bin"):
    shutil.copy("litfile.bin", "litfile0.bin")
else:
    print("Warning: PASS1 produced no litfile.bin, so no litfile0.bin is kept.")
if False:
    shutil.copy("COMMON0.out", "temp")
    shutil.copy("halmat.bin", "temp")
    shutil.copy("litfile.bin", "temp")
    shutil.copy("vmem.bin", "temp")

# Maybe run PASS1 tests. 
if test:
    sys.stdout.flush()
    print("======================================================")
    sys.stdout.flush()
    diff = "diff" + ext
    egrep = "egrep" + ext
    if None == findFileUsingPATH(diff):
        errorExit("Not available for --test:  " + diff )
    if None == findFileUsingPATH(egrep):
        errorExit("Not available for --test:  " + egrep)
    ported=findFileUsingPATH("HAL_S_FC.py")
    if ported == None:
        errorExit("Not available for --test:  HAL_S_FC.py")
    fullPath = os.path.join(ported, "HAL_S_FC.py")
    ported=Path(ported).parent
    if ported == None:
        errorExit("Not available for --test:  HAL_S_FC.py")
    # HAL_S_FC.py's libraries are named explicitly rather than left to
    # default, since its working directory is not necessarily the one the
    # libraries are in.  Its inclusion library is PASS1's very own -- the
    # members are pure EBCDIC and it only reads them -- while its template
    # library is the separate TEMPLIBp, which the comparison below holds
    # against PASS1's TEMPLIB.
    command = 'python "%s" %s %s %s %s %s %s --templib' \
              ' --templib-dir="%s" --inclib-dir="%s" --hal="%s" >pass1p.rpt' \
                         % (fullPath, TARGET, parmString.replace(",", " "),
                            rsbTrace, prettyBNF, debugLiterals, sdfiSwitch,
                            TEMPLIBPABS, INCLIBABS, halsFileAbs)
    #print(command)
    if verbose:
        print(command)
    exitCode = os.system(command)
    if exitCode:
        if force:
            if pendingFailure == None:
                pendingFailure = ""
