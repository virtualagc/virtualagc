# there, where the next compilation in dependency order could never read them.
# So it is named explicitly, whether or not --sdfi was given, since --sdfi
# governs only the reading of SDFs.
sdfoAbs = fromInvocation("SDFLIB")

filesPorted = ["FILE4.bin", "FILE5.bin", 
               "FILE6.bin", "&&TEMPLIB.json", "&&TEMPINC.json", "SOURCECO.txt",
