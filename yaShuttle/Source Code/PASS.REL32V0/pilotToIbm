#!/usr/bin/env python3
"""Convert BFS PILOT object members (cards/) to PASS/OS360-style cards.bin.

Usage:
    pilotToIbm [-o cards.bin] [--no-stack-sym] [--no-ctl] [--verbose] cards_dir

Each file in cards_dir is one PILOT object member and becomes one PASS
module (ESD/TXT/RLD/SYM/END).  Modules are concatenated into a single deck
that lnk101 can read.

Stack / halt / ON ERROR linkage (pilotToIbm-problem.md):
    BFS puts stack size on the CSD and normally starts with SVC 15; ON ERROR
    programs overlay that with a BC.  PASS/lnk101 NOSDL needs @0PROG ER,
    #EPROG PDE, STACKEND SYM, LHI R0,@0PROG+YCON, and a trailing halt SVC
    (C9F9 halt SVC; 0x0015 is *appended* to #D if missing — never overwrites
    existing data).  synthesize_pass_stack_linkage() rebuilds that contract on
    the scattered program image after each PILOT member is parsed.

Units:
    PILOT lengths/addresses are halfword-oriented; PASS card fields use bytes.
    Conversion multiplies halfword quantities by 2 where appropriate.

RLD flags:
    PILOT uses a 16-bit BFS flag halfword (OBJECTGE ASSEMBLE_RLD_FLAGS form).
    PASS uses an 8-bit AP-101 flag byte (YCON=0x00, ZCON/addr=0x10, ...).
"""

from __future__ import annotations

import argparse
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import BinaryIO

# EBCDIC encode table (ASCII 0..127) — same mapping as virtualagc asciiToEbcdic.py
_ASCII_TO_EBCDIC = [
    0, 1, 2, 3, 55, 45, 46, 47, 22, 5, 37, 11, 12, 13, 14, 15, 16, 17, 18, 19,
    60, 61, 50, 38, 24, 25, 63, 39, 28, 29, 30, 31, 64, 90, 127, 123, 91, 108,
    80, 125, 77, 93, 92, 78, 107, 96, 75, 97, 240, 241, 242, 243, 244, 245, 246,
    247, 248, 249, 122, 94, 76, 126, 110, 111, 124, 193, 194, 195, 196, 197,
    198, 199, 200, 201, 209, 210, 211, 212, 213, 214, 215, 216, 217, 226, 227,
    228, 229, 230, 231, 232, 233, 173, 254, 189, 95, 109, 74, 129, 130, 131,
    132, 133, 134, 135, 136, 137, 145, 146, 147, 148, 149, 150, 151, 152, 153,
    162, 163, 164, 165, 166, 167, 168, 169, 192, 79, 208, 95, 7,
]

_EBCDIC_TO_ASCII = ["?"] * 256
for _i, _e in enumerate(_ASCII_TO_EBCDIC):
    if 32 <= _i < 127:
        _EBCDIC_TO_ASCII[_e] = chr(_i)
_EBCDIC_TO_ASCII[0x40] = " "
# HAL names use # $ @
_EBCDIC_TO_ASCII[0x7B] = "#"
_EBCDIC_TO_ASCII[0x5B] = "$"
_EBCDIC_TO_ASCII[0x7C] = "@"


def to_ebcdic(s: str, length: int) -> bytes:
    out = bytearray()
    for i in range(length):
        if i < len(s):
            c = ord(s[i])
            out.append(_ASCII_TO_EBCDIC[c] if c < 128 else 0x40)
        else:
            out.append(0x40)
    return bytes(out)


def from_ebcdic(data: bytes) -> str:
    return "".join(_EBCDIC_TO_ASCII[b] if b < 256 else "?" for b in data).rstrip()


def be16(v: int) -> bytes:
    return (v & 0xFFFF).to_bytes(2, "big")


def be24(v: int) -> bytes:
    return (v & 0xFFFFFF).to_bytes(3, "big")


def u16(data: bytes, off: int) -> int:
    return int.from_bytes(data[off : off + 2], "big")


def blanks(n: int) -> bytearray:
    return bytearray([0x40] * n)


# ---------------------------------------------------------------------------
# PILOT parse
# ---------------------------------------------------------------------------

@dataclass
class EsdItem:
    esd_id: int
    kind: str  # "SD" | "ER" | "LD"
    name: str
    length_hw: int = 0  # SD length in halfwords
    stacksize_hw: int = 0  # SD stack in halfwords
    flags: int = 0
    address_hw: int = 0  # LD address in halfwords
    ldid: int = 0  # LD owning SD
    hal_name: str = ""


@dataclass
class TextChunk:
    esd_id: int
    address_hw: int
    data: bytes  # raw bytes (even length)
    protected: bool


@dataclass
class RldItem:
    rel_id: int
    pos_id: int
    flags: int  # PILOT 16-bit (ignored when pass_flags is set)
    address_hw: int
    pass_flags: int | None = None  # if set, emit this PASS flag byte as-is


@dataclass
class PilotMember:
    name: str
    origin: int = 0
    esd: list[EsdItem] = field(default_factory=list)
    text: list[TextChunk] = field(default_factory=list)
    rlds: list[RldItem] = field(default_factory=list)
    end_hal: str = ""
    end_xpl: str = ""
    lec: list[bytes] = field(default_factory=list)
    # PASS-style CTL STACK operand names ($0PROG) synthesized for stack linkage
    stack_ctl_names: list[str] = field(default_factory=list)


def program_characteristic(name: str) -> str | None:
    """HAL/S characteristic stem used in #E/#D/@n/$n names (max 6 chars).

    Examples: $HELLO -> HELLO, $0HELLO -> HELLO, $EXAMPLE -> EXAMPL, $P -> P.
    """
    if not name.startswith("$"):
        return None
    rest = name[1:]
    if rest and rest[0].isdigit():
        rest = rest[1:]
    if not rest:
        return None
    return rest[:6]


# lnk101 STACK_SEQUENCE: stack/task index char in @nCHAR / $nCHAR names.
_STACK_SEQUENCE = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"

# BFS NOSDL-style program prolog: SVC 15 (C9FB 00xx) requests a stack from a
# supervisor that yaGPC2/lnk101 do not provide.  PASS instead does
# LHI R0,@nPROG (E8F3 0000) with a YCON RLD so the linker fills the stack
# address.  See pilotToIbm-problem.md.
_BFS_STACK_SVC0 = 0xC9
_BFS_STACK_SVC1 = 0xFB
_PASS_LHI_R0 = bytes([0xE8, 0xF3, 0x00, 0x00])
# PASS-style program close: C9F9 + displacement to a 0x0015 halfword in #D.
# Default disp 0; synthesize_pass_stack_linkage appends 0x0015 at end of #D
# when needed so real data is never overwritten.
_PASS_HALT_SVC = bytes([0xC9, 0xF9, 0x00, 0x00])
# PDE slot size in halfwords (TERMINAT / patchStackPDEs).
_PDE_SLOT_HW = 6
# Last halfword of each PDE slot as seen on multi-task PASS objects (219-P):
# program slot 0005, first task 0003, further tasks 0000.
_PDE_SLOT_TAIL = (0x0005, 0x0003)


def _pde_slot_bytes(slot_index: int) -> bytes:
    """12-byte PDE slot image (zeros, 0x0700, tail word)."""
    tail = (
        _PDE_SLOT_TAIL[slot_index]
        if slot_index < len(_PDE_SLOT_TAIL)
        else 0x0000
    )
    return bytes.fromhex("00000000000007000000") + tail.to_bytes(2, "big")


def _scatter_section(member: PilotMember, esd_id: int, length_hw: int) -> bytearray:
    """Build a contiguous halfword image for one CSECT from TXT chunks."""
    img = bytearray(max(length_hw, 0) * 2)
    for t in member.text:
        if t.esd_id != esd_id:
            continue
        start = t.address_hw * 2
        end = start + len(t.data)
        if end > len(img):
            img.extend(bytes(end - len(img)))
        img[start:end] = t.data
    return img


def _replace_section_text(
    member: PilotMember, esd_id: int, image: bytes, *, protected: bool = True
) -> None:
    member.text = [t for t in member.text if t.esd_id != esd_id]
    if image:
        member.text.append(
            TextChunk(
                esd_id=esd_id,
                address_hw=0,
                data=bytes(image),
                protected=protected,
            )
        )


def _drop_rlds_at(member: PilotMember, pos_id: int, address_hw: int) -> None:
    """Remove every RLD that patches halfword address_hw in section pos_id."""
    member.rlds = [
        r
        for r in member.rlds
        if not (r.pos_id == pos_id and r.address_hw == address_hw)
    ]


def _ensure_ycon_rld(
    member: PilotMember, rel_id: int, pos_id: int, address_hw: int
) -> None:
    for r in member.rlds:
        if r.pos_id == pos_id and r.address_hw == address_hw and r.rel_id == rel_id:
            r.pass_flags = 0x00
            return
    member.rlds.insert(
        0,
        RldItem(
            rel_id=rel_id,
            pos_id=pos_id,
            flags=0,
            address_hw=address_hw,
            pass_flags=0x00,
        ),
    )


def synthesize_pass_stack_linkage(member: PilotMember, *, verbose: bool = False) -> None:
    """Add PASS NOSDL stack/halt contract items missing from BFS PILOT.

    BFS emits one ``$NAME`` CSECT per PROGRAM/TASK with a CSD stacksize.
    PASS names them ``$nCHAR`` / ``@nCHAR`` sharing one multi-slot ``#ECHAR``
    PDE (n from STACK_SEQUENCE: 0=PROGRAM, 1..=TASK).  BFS task CSECTs keep
    the full task name (``$GUIDANC``) — we remap to ``$1P`` etc. using the
    *program* characteristic (from the first ``$`` stack unit / its HAL name).

    Per stack unit, also rewrite entry (SVC15 or ON ERROR BC) to
    ``LHI R0,@n`` and append a ``C9F9`` halt SVC (without mutating ``#D``).
    """
    # ESD order: first $ stack unit is the PROGRAM; further ones are TASKs.
    units = [
        e
        for e in list(member.esd)
        if e.kind == "SD" and e.stacksize_hw > 0 and e.name.startswith("$")
    ]
    if not units:
        return
    if len(units) > len(_STACK_SEQUENCE):
        raise ValueError(
            f"too many PROGRAM/TASK stack units ({len(units)}); "
            f"STACK_SEQUENCE only has {len(_STACK_SEQUENCE)} slots"
        )

    # Characteristic from PROGRAM (first unit): use the $ CSECT stem so we
    # match existing #D/#E-style names ($TESTX -> TESTX -> #DTESTX).  HAL
    # names may include '_' (TEST_X) and would miss the ESD.
    prog0 = units[0]
    char = program_characteristic(prog0.name)
    if not char:
        return
    char = char[:6]
    d_name = ("#D" + char)[:8]
    e_name = ("#E" + char)[:8]

    by_name = {e.name: e for e in member.esd}
    # If #D{char} is absent, try alnum-only HAL name (rare alternate spelling).
    if d_name not in by_name and prog0.hal_name:
        alt = "".join(c for c in prog0.hal_name if c.isalnum())[:6]
        if alt and ("#D" + alt)[:8] in by_name:
            char = alt
            d_name = ("#D" + char)[:8]
            e_name = ("#E" + char)[:8]
    next_id = max(e.esd_id for e in member.esd)

    def alloc_id() -> int:
        nonlocal next_id
        next_id += 1
        return next_id

    # --- rename $ units to $nCHAR and create @nCHAR ERs ---
    unit_meta: list[tuple[EsdItem, str, str, int]] = []  # item, $n, @n, slot
    for slot, unit in enumerate(units):
        seq = _STACK_SEQUENCE[slot]
        pass_name = ("$" + seq + char)[:8]
        at_name = ("@" + seq + char)[:8]
        old = unit.name
        if unit.name != pass_name:
            if verbose:
                print(
                    f"  rename stack unit {old!r} -> {pass_name!r} (slot {slot})",
                    file=sys.stderr,
                )
            by_name.pop(old, None)
            unit.name = pass_name
            by_name[pass_name] = unit
        if at_name not in by_name:
            at_id = alloc_id()
            member.esd.append(EsdItem(esd_id=at_id, kind="ER", name=at_name))
            by_name[at_name] = member.esd[-1]
            if verbose:
                print(f"  add stack ER {at_name} esdid={at_id}", file=sys.stderr)
        else:
            at_id = by_name[at_name].esd_id
        unit_meta.append((unit, pass_name, at_name, slot))
        if pass_name not in member.stack_ctl_names:
            member.stack_ctl_names.append(pass_name)

    # --- single multi-slot PDE #ECHAR ---
    n_slots = len(units)
    pde_len_hw = _PDE_SLOT_HW * n_slots
    d_item = by_name.get(d_name)
    if e_name not in by_name:
        e_id = alloc_id()
        e_item = EsdItem(
            esd_id=e_id,
            kind="SD",
            name=e_name,
            length_hw=pde_len_hw,
            stacksize_hw=0,
            flags=0x4000,
        )
        member.esd.append(e_item)
        by_name[e_name] = e_item
        if verbose:
            print(
                f"  add PDE SD {e_name} esdid={e_id} slots={n_slots}",
                file=sys.stderr,
            )
    else:
        e_item = by_name[e_name]
        e_id = e_item.esd_id
        e_item.length_hw = max(e_item.length_hw, pde_len_hw)

    # Drop any prior PDE text/RLDs we may re-emit (idempotent re-run safety).
    member.text = [t for t in member.text if t.esd_id != e_id]
    member.rlds = [
        r
        for r in member.rlds
        if not (r.pos_id == e_id and r.pass_flags in (0x10, 0x40))
    ]

    for unit, pass_name, at_name, slot in unit_meta:
        slot_off = slot * _PDE_SLOT_HW  # halfwords
        member.text.append(
            TextChunk(
                esd_id=e_id,
                address_hw=slot_off,
                data=_pde_slot_bytes(slot),
                protected=True,
            )
        )
        # ZCON/addr: code CSECT into this PDE slot at hw offset +2
        member.rlds.append(
            RldItem(
                rel_id=unit.esd_id,
                pos_id=e_id,
                flags=0,
                address_hw=slot_off + 2,
                pass_flags=0x10,
            )
        )
        if d_item is not None and d_item.kind == "SD":
            member.rlds.append(
                RldItem(
                    rel_id=d_item.esd_id,
                    pos_id=e_id,
                    flags=0,
                    address_hw=slot_off + 2,
                    pass_flags=0x40,
                )
            )

    # Program-end halt SVC (C9F9 + disp).  yaGPC2 reads mem[R1+disp] and
    # treats halfword 0x0015 as clean halt.  Never *overwrite* existing #D
    # payload (that corrupted DO-FOR steps / literals — see
    # pilotToIbm-problem.md).  Reuse an existing 0x0015 if present; otherwise
    # *append* one halfword at the end of #D and point the SVC there.
    halt_svc = _PASS_HALT_SVC
    if d_item is not None and d_item.kind == "SD":
        d_img = bytearray(
            _scatter_section(member, d_item.esd_id, d_item.length_hw)
        )
        if len(d_img) % 2:
            d_img.append(0)
        halt_disp_hw = None
        for off in range(0, len(d_img) - 1, 2):
            if d_img[off : off + 2] == bytes([0x00, 0x15]):
                halt_disp_hw = off // 2
                break
        if halt_disp_hw is None:
            halt_disp_hw = len(d_img) // 2
            d_img.extend(bytes([0x00, 0x15]))
            d_item.length_hw = len(d_img) // 2
            _replace_section_text(member, d_item.esd_id, bytes(d_img))
            if verbose:
                print(
                    f"  append halt word 0x0015 to {d_name} at hw {halt_disp_hw}",
                    file=sys.stderr,
                )
        halt_svc = bytes([0xC9, 0xF9]) + int(halt_disp_hw).to_bytes(2, "big")

    # BFS nested FUNCTION bodies often end with ``C9FB FFFF`` (SVC ea=0x7FFF)
    # immediately before ``97E8`` SRET.  That SVC traps in yaGPC2; PASS uses a
    # different epilogue.  Neutralize the bad SVC with NOPs and keep SRET so
    # the function still returns (do *not* turn this into a program-halt SVC).
    # Two BCR 0,0 (no-op branches) — same filler IOINIT uses as a pad.
    _NOP4 = bytes([0xC0, 0xE0, 0xC0, 0xE0])

    def _rewrite_ffff_svcs(img: bytearray) -> int:
        n = 0
        for i in range(0, len(img) - 3, 2):
            if img[i : i + 4] == bytes([0xC9, 0xFB, 0xFF, 0xFF]):
                img[i : i + 4] = _NOP4
                n += 1
        return n

    for e in list(member.esd):
        if e.kind != "SD" or e.name.startswith("#"):
            continue
        # Nested code blocks A1… / B0… (not the $ PROGRAM/TASK units — those
        # get a real halt below).
        if not (len(e.name) >= 2 and e.name[0].isalpha() and e.name[1].isdigit()):
            continue
        img = bytearray(_scatter_section(member, e.esd_id, e.length_hw))
        n = _rewrite_ffff_svcs(img)
        if n:
            e.length_hw = max(e.length_hw, (len(img) + 1) // 2)
            _replace_section_text(member, e.esd_id, bytes(img))
            if verbose:
                print(
                    f"  neutralize {n}x C9FB FFFF in nested {e.name}",
                    file=sys.stderr,
                )

    # --- per-unit entry rewrite + halt ---
    for unit, pass_name, at_name, slot in unit_meta:
        at_id = by_name[at_name].esd_id
        p_img = bytearray(
            _scatter_section(member, unit.esd_id, unit.length_hw)
        )
        if len(p_img) < 4:
            continue

        entry0, entry1 = p_img[0], p_img[1]
        if entry0 == _BFS_STACK_SVC0 and entry1 == _BFS_STACK_SVC1:
            p_img[0:4] = _PASS_LHI_R0
            _drop_rlds_at(member, unit.esd_id, 1)
            _ensure_ycon_rld(member, at_id, unit.esd_id, 1)
            if verbose:
                print(
                    f"  rewrite {pass_name} entry SVC15 -> LHI R0,{at_name}",
                    file=sys.stderr,
                )
        elif entry0 == 0xC7:
            p_img[0:4] = _PASS_LHI_R0
            _drop_rlds_at(member, unit.esd_id, 1)
            _ensure_ycon_rld(member, at_id, unit.esd_id, 1)
            body_hw = 0x11
            if len(p_img) >= (body_hw + 1) * 2:
                p_img[9 * 2 : 9 * 2 + 2] = bytes([0xC7, 0xF3])
                p_img[9 * 2 + 2 : 9 * 2 + 4] = body_hw.to_bytes(2, "big")
                _drop_rlds_at(member, unit.esd_id, 10)
                _ensure_ycon_rld(member, unit.esd_id, unit.esd_id, 10)
            if verbose:
                print(
                    f"  rewrite {pass_name} ON ERROR BC entry -> "
                    f"LHI R0,{at_name} + BC to body@{body_hw:#x}",
                    file=sys.stderr,
                )
        else:
            if verbose:
                print(
                    f"  note: {pass_name} entry opcode "
                    f"{entry0:02x}{entry1:02x} not SVC15/BC — stack ER only",
                    file=sys.stderr,
                )

        if len(p_img) >= 4 and p_img[-4:-2] == bytes([0xC9, 0xF9]):
            p_img[-4:] = halt_svc
        else:
            if verbose:
                print(f"  append halt SVC to {pass_name}", file=sys.stderr)
            p_img.extend(halt_svc)

        unit.length_hw = max(unit.length_hw, (len(p_img) + 1) // 2)
        _replace_section_text(member, unit.esd_id, bytes(p_img))


def parse_pilot_member(path: Path) -> PilotMember:
    data = path.read_bytes()
    if len(data) % 2:
        raise ValueError(f"{path}: odd length {len(data)}")
    member = PilotMember(name=path.name)
    # Local ESD map for this member (1-based); coPILOT global list is wrong
    # across members when IDs restart per member.
    sections: dict[int, str] = {}
    next_id = 1
    offset = 0
    n = len(data)

    while offset < n:
        typ = data[offset]
        typ2 = data[offset + 1]

        if typ == 0x01:
            if typ2 != 0x02:
                raise ValueError(f"{path}: bad Start at {offset:#x}")
            member.origin = u16(data, offset + 2)
            offset += 4

        elif typ == 0x02:  # CSD
            end = offset + 2 * (7 + typ2 - 7)
            # typ2 is halfword length of record? coPILOT: endOffset = offset + 2*(7+type2-7)
            # which simplifies to offset + 2*type2. Wait: 7+type2-7 = type2, so end = offset+2*type2
            end = offset + 2 * typ2
            name = from_ebcdic(data[offset + 2 : offset + 10])
            length_hw = u16(data, offset + 10)
            stack_hw = u16(data, offset + 12)
            flags = u16(data, offset + 14) if offset + 16 <= end else 0
            hal = from_ebcdic(data[offset + 16 : end]) if offset + 16 < end else ""
            esd_id = next_id
            next_id += 1
            sections[esd_id] = name
            member.esd.append(
                EsdItem(
                    esd_id=esd_id,
                    kind="SD",
                    name=name,
                    length_hw=length_hw,
                    stacksize_hw=stack_hw,
                    flags=flags,
                    hal_name=hal,
                )
            )
            offset = end

        elif typ == 0x03:  # ENT — 16-byte record (fields incompletely documented)
            # Layout guess aligned with ESD LD-ish: name[8], addr halfword?, parent?
            name = from_ebcdic(data[offset + 2 : offset + 10])
            addr_hw = u16(data, offset + 10)
            ldid = u16(data, offset + 12)
            esd_id = next_id
            next_id += 1
            sections[esd_id] = name
            member.esd.append(
                EsdItem(
                    esd_id=esd_id,
                    kind="LD",
                    name=name,
                    address_hw=addr_hw,
                    ldid=ldid or 1,
                )
            )
            offset += 16

        elif typ == 0x04:  # EXR
            end = offset + 2 * typ2
            name = from_ebcdic(data[offset + 2 : offset + 10])
            esd_id = next_id
            next_id += 1
            sections[esd_id] = name
            member.esd.append(EsdItem(esd_id=esd_id, kind="ER", name=name))
            offset = end

        elif typ == 0x05:  # LEC
            end = offset + 2 * (1 + typ2)
            member.lec.append(data[offset:end])
            offset = end

        elif typ in (0x06, 0x07):  # PTX / UTX
            addr_hw = u16(data, offset + 2)
            csect_id = u16(data, offset + 4)
            # payload halfwords: typ2 - 3 (header uses 3 halfwords: type, addr, csect)
            payload_hw = typ2 - 3
            payload = data[offset + 6 : offset + 6 + 2 * payload_hw]
            member.text.append(
                TextChunk(
                    esd_id=csect_id,
                    address_hw=addr_hw,
                    data=bytes(payload),
                    protected=(typ == 0x06),
                )
            )
            offset = offset + 6 + 2 * payload_hw

        elif typ == 0x08:  # RLD
            end = offset + 2 * typ2
            i = offset + 2
            # OBJECTGE ADD_RLD: a full entry is R,P,flags,addr (4 hw).  If
            # flags bit0 is set, one or more *short* entries follow (flags,addr
            # only), reusing the same R/P until a short entry clears bit0.
            last_rel = last_pos = None
            while i + 4 <= end:
                if last_rel is not None:
                    fl = u16(data, i)
                    adr = u16(data, i + 2)
                    member.rlds.append(
                        RldItem(
                            rel_id=last_rel,
                            pos_id=last_pos,
                            flags=fl,
                            address_hw=adr,
                        )
                    )
                    if (fl & 1) == 0:
                        last_rel = last_pos = None
                    i += 4
                    continue
                if i + 8 > end:
                    break
                rel = u16(data, i)
                pos = u16(data, i + 2)
                fl = u16(data, i + 4)
                adr = u16(data, i + 6)
                member.rlds.append(
                    RldItem(rel_id=rel, pos_id=pos, flags=fl, address_hw=adr)
                )
                if fl & 1:
                    last_rel, last_pos = rel, pos
                i += 8
            offset = end

        elif typ == 0x09:  # END
            # Fixed-ish 20 halfwords per coPILOT comments; length field is typ2
            member.end_hal = from_ebcdic(data[offset + 4 : offset + 14])
            member.end_xpl = from_ebcdic(data[offset + 22 : offset + 32])
            offset = offset + 2 * typ2
            break

        elif typ == 0x40:
            break

        else:
            raise ValueError(
                f"{path}: unsupported card type {typ:#04x} at offset {offset:#x}"
            )

    return member


def pilot_rld_flags_to_pass(pilot_flags: int) -> int:
    """Map BFS PILOT RLD flag halfword to PASS 8-bit RLD flag.

    PILOT form (low byte, from OBJECTGE PRINT_RLD_LEGEND / ASSEMBLE_RLD_FLAGS):
      V0XX0000  2-byte standard (YCON-like)
      V0XX0100  4-byte standard (ACON-like)
      V0101x00  code ZCON variants
      V0001x00  data ZCON variants
    PASS (ap101Utils.addrcon):
      0x00 YCON, 0x04 ZCON/code, 0x10 ZCON/addr, 0x1C ACON,
      0x20 BSR-only, 0x40 DSR-only, 0x50 ZCON/data; bit7 = negate.

    Continuations (bit0) are expanded to full RLD entries at parse time, so
    the emitted PASS flag never sets the continuation bit.
    """
    f = pilot_flags & 0xFF
    sign = 0x80 if (f & 0x80) else 0
    # Ignore PILOT continuation bit — we only punch full 8-byte RLD items.
    low = f & 0x7E

    # Explicit ZCON-ish BFS values produced by ASSEMBLE_RLD_FLAGS
    if low in (0x2C, 0x28):  # code ZCON sector / sector+address
        return sign | 0x10
    if low in (0x1C, 0x18):  # data ZCON sector+address / sector
        return sign | 0x10
    if low in (0x0C, 0x08):
        return sign | 0x50

    # Standard address: bits 3-2 (0x0C) select 2-byte vs 4-byte
    if (low & 0x0C) == 0x04:
        return sign | 0x1C  # ACON
    if (low & 0x0C) == 0x00:
        # V0XX0000 including 0x10 (ZCON csect type) and 0x20 (LIBRARY) —
        # both are 2-byte standard adcons in samples → YCON
        return sign | 0x00

    # Already a known PASS flag?
    if low in (0x00, 0x04, 0x10, 0x1C, 0x20, 0x40, 0x50):
        return sign | low

    return sign | 0x00


# ---------------------------------------------------------------------------
# PASS emit
# ---------------------------------------------------------------------------

def make_card(rec_type: str, data68: bytes | bytearray, seq: int) -> bytes:
    card = blanks(80)
    card[0] = 0x02
    card[1:4] = to_ebcdic(rec_type, 3)
    card[4 : 4 + min(len(data68), 68)] = data68[:68]
    card[72:80] = to_ebcdic(f"{seq % 100000000:08d}", 8)
    return bytes(card)


def stack_frame_sym_payload(csect: str, frame_bytes: int) -> bytes:
    """CONTROL/DUMMY STACK/DATA STACKEND triple (HAL/S-FC style)."""

    def ref_bytes(sym_type: int, name: str, offset: int) -> bytes:
        org = (sym_type << 4) | (len(name) - 1)
        return bytes([org]) + be24(offset) + to_ebcdic(name, len(name))

    # SymRefType: CONTROL=0b001, DUMMY=0b010
    stackend = (
        bytes([0x80 | (len("STACKEND") - 1)])
        + be24(frame_bytes)
        + to_ebcdic("STACKEND", 8)
        + bytes([0x14, 2 - 1])  # HALFWORD type, length 2
    )
    return (
        ref_bytes(0b001, csect, 0)
        + ref_bytes(0b010, "STACK", 0)
        + stackend
    )


def write_pass_module(
    out: BinaryIO,
    member: PilotMember,
    *,
    seq: int = 1,
    emit_stack_sym: bool = True,
    emit_ctl_stack: bool = True,
    verbose: bool = False,
) -> int:
    """Write one PASS module for one PILOT member. Returns next sequence number."""
    esd_items = member.esd
    if not esd_items and not member.text:
        if verbose:
            print(f"  skip empty member {member.name}", file=sys.stderr)
        return seq

    # Stack-frame SYM (HAL/S-FC CONTROL/STACK/STACKEND); emit before ESD
    # like typical compiler decks.
    sym_payload = b""
    if emit_stack_sym:
        for e in esd_items:
            if e.kind == "SD" and e.stacksize_hw > 0:
                sym_payload += stack_frame_sym_payload(e.name, e.stacksize_hw * 2)

    for off in range(0, len(sym_payload), 56):
        chunk = sym_payload[off : off + 56]
        data = blanks(68)
        data[6:8] = be16(len(chunk))
        data[12 : 12 + len(chunk)] = chunk
        out.write(make_card("SYM", data, seq))
        seq += 1

    # ESD cards (up to 3 entries each)
    for i in range(0, len(esd_items), 3):
        batch = esd_items[i : i + 3]
        data = blanks(68)
        data[6:8] = be16(len(batch) * 16)
        data[10:12] = be16(batch[0].esd_id)
        for j, e in enumerate(batch):
            o = 12 + j * 16
            data[o : o + 8] = to_ebcdic(e.name, 8)
            if e.kind == "SD":
                data[o + 8] = 0x00
                data[o + 9 : o + 12] = be24(0)
                data[o + 12] = 0x40  # common blank/AMODE filler
                data[o + 13 : o + 16] = be24(e.length_hw * 2)
            elif e.kind == "LD":
                data[o + 8] = 0x01
                data[o + 9 : o + 12] = be24(e.address_hw * 2)
                data[o + 12] = 0x40
                data[o + 13] = 0x40
                data[o + 14 : o + 16] = be16(e.ldid)
            else:  # ER
                data[o + 8] = 0x02
                data[o + 9 : o + 12] = be24(0)
                data[o + 12 : o + 16] = bytes([0x40, 0x40, 0x40, 0x40])
        out.write(make_card("ESD", data, seq))
        seq += 1

    # TXT — emit each chunk as one or more cards (addresses in bytes)
    for t in member.text:
        addr = t.address_hw * 2
        payload = t.data
        for off in range(0, len(payload), 56):
            chunk = payload[off : off + 56]
            data = blanks(68)
            data[1:4] = be24(addr + off)
            data[6:8] = be16(len(chunk))
            data[10:12] = be16(t.esd_id)
            data[12 : 12 + len(chunk)] = chunk
            out.write(make_card("TXT", data, seq))
            seq += 1

    # RLD
    rlds = member.rlds
    for i in range(0, len(rlds), 7):
        batch = rlds[i : i + 7]
        data = blanks(68)
        data[6:8] = be16(len(batch) * 8)
        for j, r in enumerate(batch):
            o = 12 + j * 8
            data[o : o + 2] = be16(r.rel_id)
            data[o + 2 : o + 4] = be16(r.pos_id)
            if r.pass_flags is not None:
                data[o + 4] = r.pass_flags & 0xFF
            else:
                data[o + 4] = pilot_rld_flags_to_pass(r.flags)
            data[o + 5 : o + 8] = be24(r.address_hw * 2)
        out.write(make_card("RLD", data, seq))
        seq += 1

    # END.  make_card places data68 at card[4:], so:
    #   data[1:4]=card[5:8] entry, data[10:12]=card[14:16] esdid,
    #   data[28]=card[32] IDR type, data[29:48]=translator, data[48:67]=processor.
    end_data = blanks(68)
    ident = (member.end_hal or "HAL/S BFC")[:19]
    end_data[28] = 0xF2  # IDR type 2
    end_data[29:48] = to_ebcdic(ident, 19)
    proc = (member.end_xpl or "pilotToIbm")[:19]
    end_data[48:67] = to_ebcdic(proc, 19)
    out.write(make_card("END", end_data, seq))
    seq += 1

    # Optional CTL STACK cards.  Prefer synthesized $0PROG names so
    # lnk101's $ -> @ mapping yields @0PROG (same as PASS / stacksizer).
    if emit_ctl_stack:
        ctl_names = list(member.stack_ctl_names)
        if not ctl_names:
            ctl_names = [
                e.name
                for e in esd_items
                if e.kind == "SD" and e.stacksize_hw > 0 and e.name.startswith("$")
            ]
        for cname in ctl_names:
            # Free-format control card (not 0x02-led). PASS uses " STACK $0PROG"
            text = f" STACK {cname}"
            card = blanks(80)
            eb = to_ebcdic(text, min(len(text), 72))
            card[0 : len(eb)] = eb
            out.write(bytes(card))

    return seq


def write_start_stub(out: BinaryIO, program_csect: str, seq: int) -> int:
    """Emit a PASS-style START module that YCON-branches to program_csect.

    Matches the HAL/S-FC standalone glue: SD START (4 bytes), ER program,
    TXT E4F3 0000, RLD YCON to the program at halfword 1, END entry=START.
    """
    # ESD: START SD, program ER
    data = blanks(68)
    data[6:8] = be16(32)
    data[10:12] = be16(1)
    # START SD len 4 bytes
    data[12:20] = to_ebcdic("START", 8)
    data[20] = 0x00
    data[21:24] = be24(0)
    data[24] = 0x40
    data[25:28] = be24(4)
    # ER program
    data[28:36] = to_ebcdic(program_csect, 8)
    data[36] = 0x02
    data[37:40] = be24(0)
    data[40:44] = bytes([0x40, 0x40, 0x40, 0x40])
    out.write(make_card("ESD", data, seq))
    seq += 1

    # TXT: E4F3 0000 at START+0  (BAL@# / long branch form with YCON slot)
    data = blanks(68)
    data[1:4] = be24(0)
    data[6:8] = be16(4)
    data[10:12] = be16(1)
    data[12:16] = bytes([0xE4, 0xF3, 0x00, 0x00])
    out.write(make_card("TXT", data, seq))
    seq += 1

    # RLD YCON: rel=2 (program ER), pos=1 (START), addr=2 (byte)
    data = blanks(68)
    data[6:8] = be16(8)
    data[12:14] = be16(2)
    data[14:16] = be16(1)
    data[16] = 0x00
    data[17:20] = be24(2)
    out.write(make_card("RLD", data, seq))
    seq += 1

    # END with entry at START (esdid 1), IDR type 2
    data = blanks(68)
    data[1:4] = be24(0)
    data[10:12] = be16(1)
    data[28] = 0xF2
    data[29:48] = to_ebcdic("pilotToIbm START", 19)
    data[48:67] = to_ebcdic("pilotToIbm", 19)
    out.write(make_card("END", data, seq))
    seq += 1
    return seq


def convert_cards_dir(
    cards_dir: Path,
    out_path: Path,
    *,
    members: list[str] | None = None,
    emit_stack_sym: bool = True,
    emit_ctl_stack: bool = True,
    emit_start: bool = True,
    verbose: bool = False,
) -> None:
    if not cards_dir.is_dir():
        raise FileNotFoundError(f"not a directory: {cards_dir}")

    if members:
        paths = [cards_dir / m for m in members]
    else:
        paths = sorted(
            p for p in cards_dir.iterdir() if p.is_file() and not p.name.startswith(".")
        )

    if not paths:
        raise FileNotFoundError(f"no members in {cards_dir}")

    seq = 1
    program_csect: str | None = None
    with out_path.open("wb") as out:
        for path in paths:
            if verbose:
                print(f"member {path.name}", file=sys.stderr)
            member = parse_pilot_member(path)
            if verbose:
                print(
                    f"  esd={len(member.esd)} text={len(member.text)} "
                    f"rld={len(member.rlds)}",
                    file=sys.stderr,
                )
            # BFS PILOT omits PASS NOSDL stack linkage (@0 ER, #E PDE, LHI
            # prologue).  Synthesize it so lnk101 allocates @-stacks.
            synthesize_pass_stack_linkage(member, verbose=verbose)
            # START must enter the PROGRAM ($0…), not a later TASK ($1…).
            if member.stack_ctl_names:
                program_csect = member.stack_ctl_names[0]
            else:
                for e in member.esd:
                    if (
                        e.kind == "SD"
                        and e.stacksize_hw > 0
                        and e.name.startswith("$")
                    ):
                        program_csect = e.name
                        break
            seq = write_pass_module(
                out,
                member,
                seq=seq,
                emit_stack_sym=emit_stack_sym,
                emit_ctl_stack=emit_ctl_stack,
                verbose=verbose,
            )
        if emit_start and program_csect:
            if verbose:
                print(f"START stub -> {program_csect}", file=sys.stderr)
            seq = write_start_stub(out, program_csect, seq)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="pilotToIbm",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Convert a BFS HAL/S-FC object directory (PILOT format, cards/) "
            "to a PASS-style OS/360 object deck (cards.bin) that lnk101 can link."
        ),
        epilog="""\
examples:
  pilotToIbm cards/
  pilotToIbm -o out.bin -v cards/
  pilotToIbm --member '$EXAMPLE' -o cards.bin cards/

Each file in cards_dir is one PILOT member and becomes one PASS module
(ESD/TXT/RLD/SYM/END).  By default the tool also emits stack SYM markers,
CTL STACK cards, and a START entry stub for $-prefixed program CSECTs.
""",
    )
    ap.add_argument(
        "cards_dir",
        type=Path,
        help="BFS cards/ directory of PILOT object members",
    )
    ap.add_argument(
        "-o",
        "--output",
        type=Path,
        default=Path("cards.bin"),
        metavar="FILE",
        help="output PASS object deck (default: cards.bin)",
    )
    ap.add_argument(
        "--member",
        action="append",
        dest="members",
        metavar="NAME",
        help="convert only this member (repeatable); default: all files, sorted",
    )
    ap.add_argument(
        "--no-stack-sym",
        action="store_true",
        help="omit SYM STACK/STACKEND records derived from CSD stacksize",
    )
    ap.add_argument(
        "--no-ctl",
        action="store_true",
        help="omit free-format CTL ' STACK <csect>' cards after each module",
    )
    ap.add_argument(
        "--no-start",
        action="store_true",
        help="omit synthesized START entry stub for $PROGRAM CSECTs",
    )
    ap.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="print member stats and output size to stderr",
    )
    args = ap.parse_args(argv)

    try:
        convert_cards_dir(
            args.cards_dir,
            args.output,
            members=args.members,
            emit_stack_sym=not args.no_stack_sym,
            emit_ctl_stack=not args.no_ctl,
            emit_start=not args.no_start,
            verbose=args.verbose,
        )
    except Exception as e:
        print(f"pilotToIbm: {e}", file=sys.stderr)
        return 1

    if args.verbose:
        size = args.output.stat().st_size
        print(f"wrote {args.output} ({size} bytes, {size // 80} cards)", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
