# Source PDFs (large, third-party; not meant to live in the repo).
# Exception: the pdftotext -layout full-text extractions of the primary
# HAL/S reference manuals (USA003087, USA003088, USA003090) and the
# "Programming in HAL/S" textbook are small, durable, and worth keeping
# versioned alongside the reengineered-documentation that cites them --
# everything else under here (PDFs themselves, one-off scratch files)
# stays ignored.
source-documentation/*
!source-documentation/USA003087.txt
!source-documentation/USA003088.txt
!source-documentation/USA003090.txt
!source-documentation/ProgrammingInHALS.txt

# Eclipse IDE project files
.project
.settings/

# OS cruft
.DS_Store
Thumbs.db

# Editor swap/backup files
*.swp
*~

# RTK (Rust Token Killer) tooling artifacts — local Claude Code proxy
# infrastructure, not a project dependency
node_modules/
package.json
package-lock.json

# Claude Code: personal/machine-local, not shared project config.
# .claude/settings.json, .claude/commands/, .claude/agents/, etc. (if
# ever added) are meant to be shared and should still be committed.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# yaHALMAT2 (Phase 3) build artifacts
src/*.o
src/*.obj
src/*.d
src/yaHALMAT2
src/yaHALMAT2.exe
src/gpc_smoke_test
src/gpc_smoke_test.exe
src/gpc_textio_test
src/gpc_textio_test.exe
src/example_gpcops_paced_run
src/example_gpcops_paced_run.exe
src/*.a
/archive.results/

# example_gpcops_paced_run.c's own hard-coded fixture (a prebaked
# optmat.bin, not compiled fresh at test time the way every other HAL/S
# fixture in this repo is -- this file has no way to take a path argument,
# same reasoning as yaGPC2's own committed test/fixtures/hello.fcm).
# Overrides the repo-root .gitignore's own blanket *.bin exclusion.
!src/tests/fixtures/hello/optmat.bin
!src/tests/fixtures/hello/litfile2.bin
