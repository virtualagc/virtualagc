 TEST_BFNC_INVTRIG:
 PROGRAM;
    DECLARE SCALAR, S1, S2, S3;
    S1 = 0.5;
    S2 = ARCCOS(S1);
    WRITE(6) S2;
    S2 = ARCSIN(S1);
    WRITE(6) S2;
    S1 = 2.0;
    S2 = ARCCOS(S1);
    WRITE(6) S2;
    S2 = ARCSIN(S1);
    WRITE(6) S2;
    S1 = -2.0;
    S2 = ARCCOS(S1);
    WRITE(6) S2;
    S2 = ARCSIN(S1);
    WRITE(6) S2;
    S1 = 1.0;
    S3 = 1.0;
    S2 = ARCTAN2(S1, S3);
    WRITE(6) S2;
    S1 = 0.0;
    S3 = 0.0;
    S2 = ARCTAN2(S1, S3);
    WRITE(6) S2;
 CLOSE TEST_BFNC_INVTRIG;
