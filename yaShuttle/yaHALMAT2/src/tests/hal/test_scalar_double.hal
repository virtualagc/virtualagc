 TEST_SCALAR_DOUBLE:
 PROGRAM;
    DECLARE EOR SCALAR DOUBLE;
    DECLARE ANGULAR_SHIFT SCALAR DOUBLE;
    DECLARE DISTANCE SCALAR DOUBLE;
    EOR = 93000000.0;
    WRITE(6) EOR;
    ANGULAR_SHIFT = 0.5;
    WRITE(6) ANGULAR_SHIFT;
    DISTANCE = EOR / TAN(ANGULAR_SHIFT);
    WRITE(6) DISTANCE;
 CLOSE TEST_SCALAR_DOUBLE;
