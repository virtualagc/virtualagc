 TEST_MM14DN:
 PROGRAM;
    DECLARE M1 MATRIX(2,2) DOUBLE INITIAL(1.0,2.0,3.0,4.0);
    DECLARE M2 MATRIX(2,2) DOUBLE;
    DECLARE M3 MATRIX(3,3) DOUBLE INITIAL(1,2,3, 4,5,7, 7,8,10);
    DECLARE M4 MATRIX(3,3) DOUBLE;
    DECLARE M5 MATRIX(4,4) DOUBLE INITIAL(
       2,0,0,1,
       0,3,1,0,
       0,1,2,0,
       1,0,0,4);
    DECLARE M6 MATRIX(4,4) DOUBLE;
    M2 = M1 ** (-1);
    WRITE(6) M2;
    M4 = M3 ** (-1);
    WRITE(6) M4;
    M6 = M5 ** (-1);
    WRITE(6) M6;
 CLOSE TEST_MM14DN;
