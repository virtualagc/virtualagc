 TEST_RANDOM_F1_CHAIN:
 PROGRAM;
    DECLARE X SCALAR DOUBLE;
    DECLARE Y SCALAR DOUBLE;
    DECLARE Z SCALAR DOUBLE;
    DECLARE V SCALAR DOUBLE;
    X = RANDOM;
    Y = RANDOM;
    Z = X**2 + Y**2;
    V = RANDOM;
    WRITE(6) X;
    WRITE(6) Y;
    WRITE(6) Z;
    WRITE(6) V;
 CLOSE TEST_RANDOM_F1_CHAIN;
