 TEST_LFNC_ARRAY:
 PROGRAM;
    DECLARE SA ARRAY(4) SCALAR INITIAL(3, 7, 1, 4);
    DECLARE SCALAR, S1;
    DECLARE INTEGER, I1;
    S1 = MAX(SA);
    WRITE(6) S1;
    S1 = MIN(SA);
    WRITE(6) S1;
    S1 = SUM(SA);
    WRITE(6) S1;
    S1 = PROD(SA);
    WRITE(6) S1;
    I1 = SIZE(SA);
    WRITE(6) I1;
 CLOSE TEST_LFNC_ARRAY;
