 TEST_ARRAY_OF_VECTOR:
 PROGRAM;
    DECLARE POSITIONS ARRAY(3) VECTOR INITIAL(1, 2, 3,
                                               4, 5, 6,
                                               7, 8, 9);
    DECLARE OLD_POSN ARRAY(3) VECTOR INITIAL(1, 2, 3,
                                              3, 4, 5,
                                              5, 6, 7);
    DECLARE ARRAY(3),
               VELOCITY VECTOR,
               DISTANCE SCALAR;
    DECLARE MY_POSN VECTOR INITIAL(6, 8, 10);
    DECLARE DELTA_T SCALAR INITIAL(1);
    DECLARE I INTEGER;

    DO FOR I = 1 TO 3; WRITE(6) POSITIONS$(I:*); END;

E        -              -            -
M    [VELOCITY] = ([POSITIONS] - [OLD_POSN]) / DELTA_T;
E                            -           -
M    [DISTANCE] = ABVAL([POSITIONS] - MY_POSN);
E        -             -
M    [OLD_POSN] = [POSITIONS];

    DO FOR I = 1 TO 3; WRITE(6) VELOCITY$(I:*); END;
    DO FOR I = 1 TO 3; WRITE(6) DISTANCE$I; END;
    DO FOR I = 1 TO 3; WRITE(6) OLD_POSN$(I:*); END;
 CLOSE TEST_ARRAY_OF_VECTOR;
