 TEST_BFNC_HYPERBOLIC:
 PROGRAM;
    DECLARE SCALAR, S1, S2;
    S1 = 1.0;
    S2 = COSH(S1);
    WRITE(6) S2;
    S2 = SINH(S1);
    WRITE(6) S2;
    S2 = TANH(S1);
    WRITE(6) S2;
    S1 = 2.0;
    S2 = ARCCOSH(S1);
    WRITE(6) S2;
    S2 = ARCSINH(S1);
    WRITE(6) S2;
    S1 = 0.5;
    S2 = ARCTANH(S1);
    WRITE(6) S2;
    S1 = 0.5;
    S2 = ARCCOSH(S1);
    WRITE(6) S2;
 CLOSE TEST_BFNC_HYPERBOLIC;
