 TEST_ERON_EVENT:
 PROGRAM;
    DECLARE SCALAR, NEG4 INITIAL(-4.0);
    DECLARE SCALAR, RESULT;
    DECLARE EV1 EVENT;
    DECLARE EV2 EVENT LATCHED;
    DECLARE EV3 EVENT LATCHED;

    SIGNAL EV2;
    ON ERROR$(4:5) IGNORE AND SIGNAL EV1;
    RESULT = SQRT(NEG4);
    IF EV1 THEN
       WRITE(6) 'EV1 SET';
    ELSE
       WRITE(6) 'EV1 NOT SET';

    ON ERROR$(4:5) IGNORE AND RESET EV2;
    RESULT = SQRT(NEG4);
    IF EV2 THEN
       WRITE(6) 'EV2 SET';
    ELSE
       WRITE(6) 'EV2 NOT SET';

    ON ERROR$(4:5) IGNORE AND SET EV3;
    RESULT = SQRT(NEG4);
    IF EV3 THEN
       WRITE(6) 'EV3 SET';
    ELSE
       WRITE(6) 'EV3 NOT SET';
 CLOSE TEST_ERON_EVENT;
