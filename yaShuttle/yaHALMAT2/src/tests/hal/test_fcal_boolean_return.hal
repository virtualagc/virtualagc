 TEST_FCAL_BOOLEAN_RETURN:
 PROGRAM;
    IS_POSITIVE:
    FUNCTION(X) BOOLEAN;
       DECLARE X SCALAR;
       IF X > 0 THEN
          RETURN TRUE;
       ELSE
          RETURN FALSE;
    CLOSE IS_POSITIVE;

    WRITE(6) IS_POSITIVE(5.0);
    WRITE(6) IS_POSITIVE(-3.0);
 CLOSE TEST_FCAL_BOOLEAN_RETURN;
