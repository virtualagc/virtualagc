 TEST_ERRGRP_ERRNUM:
 PROGRAM;
    DECLARE SCALAR, S1, NEG4;
    DECLARE INTEGER, I1, I2;
    NEG4 = -4.0;
    I1 = ERRGRP;
    WRITE(6) I1;
    I2 = ERRNUM;
    WRITE(6) I2;
    S1 = SQRT(NEG4);
    WRITE(6) S1;
    I1 = ERRGRP;
    WRITE(6) I1;
    I2 = ERRNUM;
    WRITE(6) I2;
 CLOSE TEST_ERRGRP_ERRNUM;
