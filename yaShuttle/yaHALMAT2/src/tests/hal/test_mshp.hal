 TEST_MSHP:
 PROGRAM;
    DECLARE V1 VECTOR(3), V2 VECTOR(3), V3 VECTOR(3);
    DECLARE M1 MATRIX(3,3), M2 MATRIX(3,3);
    V1 = VECTOR(1, 2, 3);
    V2 = VECTOR(4, 5, 6);
    V3 = VECTOR(7, 8, 9);
    M1 = MATRIX(V1, V2, V3);
    M2 = MATRIX(1, 2, 3, 4, 5, 6, 7, 8, 9);
    WRITE(6) M1;
    WRITE(6) M2;
 CLOSE TEST_MSHP;
