 TEST_BFNC_INTOPS:
 PROGRAM;
    DECLARE INTEGER, I1, I2, I3;
    DECLARE SCALAR, S1;
    DECLARE BIT(8), B1, B2, B3;
    I1 = 17;
    I2 = 5;
    I3 = DIV(I1, I2);
    WRITE(6) I3;
    I3 = REMAINDER(I1, I2);
    WRITE(6) I3;
    S1 = MOD(I1, I2);
    WRITE(6) S1;
    I1 = -17;
    S1 = MOD(I1, I2);
    WRITE(6) S1;
    I1 = 7;
    I3 = INTEGER(ODD(I1));
    WRITE(6) I3;
    I1 = 8;
    I3 = INTEGER(ODD(I1));
    WRITE(6) I3;
    I1 = 3;
    I2 = 4;
    I3 = SHL(I1, I2);
    WRITE(6) I3;
    I1 = 256;
    I2 = 4;
    I3 = SHR(I1, I2);
    WRITE(6) I3;
    B1 = BIT(179);
    B2 = BIT(15);
    B3 = XOR(B1, B2);
    I3 = INTEGER(B3);
    WRITE(6) I3;
 CLOSE TEST_BFNC_INTOPS;
