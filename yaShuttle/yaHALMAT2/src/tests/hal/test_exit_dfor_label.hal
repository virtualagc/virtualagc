 TEST_EXIT_DFOR_LABEL:
 PROGRAM;
    DECLARE V ARRAY(5) VECTOR(3) INITIAL(3,0,0, 7,0,0, 1,0,0, 9,0,0, 5,0,0);
    DECLARE BIGTHREE ARRAY(3) VECTOR(3) INITIAL(0) AUTOMATIC;
    DECLARE N INTEGER;

    N = 5;
    DO FOR TEMPORARY I = 1 TO N;
 INNER:
       DO FOR TEMPORARY J = 1 TO 3;
          IF ABVAL(V$(I:)) > ABVAL(BIGTHREE$(J:)) THEN
             DO;
                DO FOR TEMPORARY K = 3 TO J + 1 BY -1;
                   BIGTHREE$(K:) = BIGTHREE$(K-1:);
                END;
                BIGTHREE$(J:) = V$(I:);
                EXIT INNER;
             END;
       END INNER;
    END;

    DO FOR TEMPORARY I = 1 TO 3;
       WRITE(6) ABVAL(BIGTHREE$(I:));
    END;
 CLOSE TEST_EXIT_DFOR_LABEL;
