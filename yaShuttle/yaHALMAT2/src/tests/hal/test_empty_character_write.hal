 TEST_EMPTY_CHARACTER_WRITE:
 PROGRAM;
    STRUCTURE FLAGS DENSE:
       1 B1 BOOLEAN,
       1 C CHARACTER(5);
    DECLARE STATUS FLAGS-STRUCTURE INITIAL(OFF, '');
    DECLARE C2 CHARACTER(5) INITIAL('');
    WRITE(6) C2;
    WRITE(6) 'B1=', STATUS.B1, 'C=', STATUS.C;
 CLOSE TEST_EMPTY_CHARACTER_WRITE;
