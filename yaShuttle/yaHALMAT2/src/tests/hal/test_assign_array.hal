 TEST_ASSIGN_ARRAY:
 PROGRAM;
    DECLARE FLAGS ARRAY(4) BOOLEAN, AVERAGE SCALAR;

  SETIT:
  PROCEDURE ASSIGN(FLAGS, AVERAGE);
     DECLARE ARRAY(4), FLAGS BOOLEAN;
     DECLARE AVERAGE SCALAR;
     FLAGS = FALSE;
     AVERAGE = 3.5;
  CLOSE SETIT;

    CALL SETIT ASSIGN(FLAGS, AVERAGE);
    WRITE(6) AVERAGE;
    WRITE(6) FLAGS;
 CLOSE TEST_ASSIGN_ARRAY;
