 TEST_SCHED_SELF_ON:
 PROGRAM;
    DECLARE EV1 EVENT;
    DECLARE COUNT INTEGER INITIAL(0);

    NEST:
    TASK;
       COUNT = COUNT + 1;
       IF COUNT >= 3 THEN
          CANCEL NEST;
       ELSE
          SCHEDULE NEST ON EV1 PRIORITY(80);
    CLOSE NEST;

    SCHEDULE NEST ON EV1 PRIORITY(80);
    SIGNAL EV1;
    WAIT(1);
    WRITE(6) 'COUNT=', COUNT;
 CLOSE TEST_SCHED_SELF_ON;
