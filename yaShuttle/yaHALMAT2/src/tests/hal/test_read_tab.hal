C/ DB id 39: READ-context TAB, mirroring 164-OUTER.hal's SKIP(0)/COLUMN.

  OUTER:
  PROGRAM;

     DECLARE SCALAR,
                PHI, ALPHA;

     CALL INITIALIZE;

  INITIALIZE:
  PROCEDURE;
     DECLARE VNAME CHARACTER(8);
     REPLACE INFILE BY "5";
     DO WHILE TRUE;
        READALL(INFILE) VNAME;
        VNAME = TRIM(VNAME);
        IF VNAME = 'PHI' THEN READ(INFILE) SKIP(0), TAB(8), PHI;
        IF VNAME = 'ALPHA' THEN READ(INFILE) SKIP(0), COLUMN(9), ALPHA;
        IF VNAME = 'END' THEN EXIT;
     END;
     WRITE(6) PHI, ALPHA;
  CLOSE INITIALIZE;

Y %SVCI(0);
  CLOSE OUTER;
