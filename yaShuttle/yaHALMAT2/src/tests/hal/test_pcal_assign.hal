 TEST_PCAL_ASSIGN:
 PROGRAM;
    DECLARE INTEGER, I1;
    DECLARE SCALAR, S1, S2;

  DOUBLER:
  PROCEDURE(A) ASSIGN(C);
     DECLARE INTEGER, A;
     DECLARE SCALAR, C;
     C = A 2;
  CLOSE DOUBLER;

    I1 = 5;
    CALL DOUBLER(I1) ASSIGN(S1);
    WRITE(6) S1;

    S2 = 100;
    CALL DOUBLER(I1) ASSIGN(S2);
    WRITE(6) S2;
 CLOSE TEST_PCAL_ASSIGN;
