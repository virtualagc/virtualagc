 TEST_DTAN_PRECISION:
 PROGRAM;
    DECLARE SPRING VECTOR(2) DOUBLE;
    DECLARE FALL VECTOR(2) DOUBLE;
    DECLARE DEV VECTOR(2) DOUBLE;
    DECLARE ANGULAR_SHIFT SCALAR DOUBLE;
    DECLARE Y SCALAR DOUBLE;
    SPRING = VECTOR$2(1.76781036, -0.29175215);
    FALL = VECTOR$2(1.76781211, -0.29174987);
    DEV = SPRING - FALL;
    ANGULAR_SHIFT = ABVAL(DEV);
    Y = TAN(ANGULAR_SHIFT 2**(-1));
    WRITE(6) Y;
 CLOSE TEST_DTAN_PRECISION;
