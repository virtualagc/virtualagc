 TEST_BFNC_MATRIX2:
 PROGRAM;
    DECLARE M1 MATRIX(2, 3) INITIAL(1, 2, 3, 4, 5, 6),
            M2 MATRIX(3, 2);
    DECLARE SQ MATRIX(3, 3) INITIAL(1, 2, 3, 4, 5, 6, 7, 8, 9);
    DECLARE SCALAR, S1;
    M2 = TRANSPOSE(M1);
    WRITE(6) M2;
    S1 = TRACE(SQ);
    WRITE(6) S1;
 CLOSE TEST_BFNC_MATRIX2;
