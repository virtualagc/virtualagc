 TEST_SSHP_ISHP:
 PROGRAM;
    DECLARE SCALAR, S1 INITIAL(1.5), S2 INITIAL(2.5);
    DECLARE INTEGER, I1 INITIAL(10), I2 INITIAL(20);
    DECLARE SA ARRAY(2) SCALAR;
    DECLARE IA ARRAY(2) INTEGER;
    SA = SCALAR(S1, S2);
    IA = INTEGER(I1, I2);
    WRITE(6) SA;
    WRITE(6) IA;
 CLOSE TEST_SSHP_ISHP;
