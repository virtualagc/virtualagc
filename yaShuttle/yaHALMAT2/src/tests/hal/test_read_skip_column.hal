 TEST_READ_SKIP_COLUMN:
 PROGRAM;
    DECLARE VNAME CHARACTER(8);
    DECLARE SCALAR, PHI, ALPHA;
    DECLARE INTEGER, MODE;
    DO WHILE TRUE;
       READALL(5) VNAME;
       VNAME = TRIM(VNAME);
       IF VNAME = 'PHI' THEN READ(5) SKIP(0), COLUMN(9), PHI;
       IF VNAME = 'ALPHA' THEN READ(5) SKIP(0), COLUMN(9), ALPHA;
       IF VNAME = 'MODE' THEN READ(5) SKIP(0), COLUMN(9), MODE;
       IF VNAME = 'END' THEN EXIT;
    END;
    WRITE(6) PHI, ALPHA, MODE;
 CLOSE TEST_READ_SKIP_COLUMN;
